---
import Base from "../../../layouts/Base.astro";
import Art from "../../../components/Art.astro";
import { aiCourse } from "../../../data/ai-course";
import { aiSession, aiRounds, aiBring, aiNotBring, aiFrameworkSource, aiTopics, aiStyles, aiStylesSource, aiCompare } from "../../../data/ai-session";
import { url } from "../../../lib/url";
---

<Base title={aiCourse.title} current="ai" description={`${aiSession.motto}一場 ${aiSession.minutes} 分鐘的現場課，同一件事做三輪，最後做成一份 HTML 簡報帶走。`}>
  <main>
    <section class="top">
      <div class="wrap">
        <h1>AI <span class="scribble">不只是聊天</span></h1>
        <p class="sub">{aiSession.motto}</p>
        <p class="lede">
          一場 {aiSession.minutes} 分鐘的現場課，給{aiCourse.audience}。不教哪一個 AI 比較好，也不教怎麼用它寫論文。工具一直在換，這堂課只講不太會過時的東西。
        </p>
        <p class="when">
          {aiCourse.workshopDate || "日期與地點即將公布"}
          {aiCourse.workshopPlace && `　${aiCourse.workshopPlace}`}
        </p>
        <div class="actions">
          <a class="btn btn-primary" href={url("/files/ai/handout.pdf")} download="AI課_學習單.pdf">下載學習單（PDF）</a>
          <a class="btn btn-quiet" href={url("/files/ai/handout.docx")} download="AI課_學習單.docx">學習單 Word 版（可打字）</a>
          <a class="btn btn-quiet" href="#rounds">看三輪怎麼做</a>
          <a class="btn btn-quiet" href="#bring">要帶什麼來</a>
          <a class="btn btn-quiet" href={url("/courses/ai/live/")}>現場投影用的圖文頁</a>
        </div>
      </div>
    </section>

    <section class="section task">
      <div class="wrap">
        <Art name="magnifier" size={100} rotate={8} class="pinned" />
        <h2>整堂課只做一件事，做三輪</h2>
        <p class="big">{aiSession.task}</p>
        <p class="lede">
          開頭先用十分鐘看 AI 這幾年走到哪裡，接著動手。題目從下面五個挑一個，工具你自己帶。每一輪只改一樣東西，然後看結果有什麼不同。選你最熟的那一題，它講錯的地方，你一眼就看得出來。最後一輪請 AI 把做好的內容變成一份 HTML 簡報，存在你自己的電腦裡帶走。<a href={url("/files/ai/sample-deck.html")} target="_blank" rel="noopener">先看一份範例</a>
        </p>
        <ol class="topic-list">
          {
            aiTopics.map((t) => (
              <li>
                <b>{t.title}</b>
                <span>{t.use}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="section rounds" id="rounds">
      <div class="wrap">
        <h2>三輪，每輪只改一樣</h2>
        <ol class="round-list">
          {
            aiRounds.map((r) => (
              <li>
                <span class="no">{r.no}</span>
                <div>
                  <h3>{r.title}</h3>
                  <p class="change">
                    <b>這一輪不一樣的地方</b>
                    {r.change}　約 {r.min} 分鐘
                  </p>
                  {r.type.map(([label, text]) => (
                    <p class="type">
                      <b>{label}</b>
                      {text}
                    </p>
                  ))}
                  <ul>
                    {r.todo.map((t) => <li>{t}</li>)}
                  </ul>
                  <p class="idea">
                    <b>看到的觀念</b>
                    {r.idea}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="section styles-sec" id="styles">
      <div class="wrap">
        <h2>第 3 輪：HTML 簡報，挑一個風格帶走</h2>
        <p class="lede">
          HTML 簡報是一個網頁檔，雙擊就用瀏覽器打開，電腦、手機都能看。做法是請 AI 寫，你負責說清楚要什麼、檢查、叫它改。
        </p>
        <table class="cmp">
          <thead>
            <tr><th></th><th>HTML 簡報</th><th>PPT</th></tr>
          </thead>
          <tbody>
            {
              aiCompare.map(([k, h, p]) => (
                <tr>
                  <th scope="row">{k}</th>
                  <td>{h}</td>
                  <td>{p}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="lede">
          挑一個風格，把它的風格句貼在第 3 輪那段話的「風格：」後面。想做得更像，下載範本檔附給 AI，再寫「照附件範本的版型、配色和字體」。
        </p>
        <ul class="style-grid">
          {
            aiStyles.map((st) => (
              <li>
                <img src={url(`/files/ai/styles/${st.slug}.jpg`)} alt={`${st.name} 的封面`} width="800" height="450" loading="lazy" />
                <h3>
                  {st.zh}<small lang="en">{st.name}</small>
                </h3>
                <p class="fit">適合：{st.fit}</p>
                <p class="sentence">風格：{st.sentence}</p>
                <p class="links">
                  <a href={url(`/files/ai/styles/${st.slug}/template.html`)} target="_blank" rel="noopener">看範本</a>
                  <a href={url(`/files/ai/styles/${st.slug}/template.html`)} download={`範本_${st.slug}.html`}>下載範本檔</a>
                </p>
              </li>
            ))
          }
        </ul>
        <p class="credit">
          範本取自 <a href={aiStylesSource.url} lang="en">{aiStylesSource.name}</a>（{aiStylesSource.credit}，{aiStylesSource.license} 授權），共 {aiStylesSource.count} 種，這裡挑六種適合護理題目的；其他的到原網站看。完整範例：<a href={url("/files/ai/sample-deck.html")} target="_blank" rel="noopener">居家防跌衛教</a>。
        </p>
        <h3>之後還可以：做成影片</h3>
        <p class="lede">
          <a href="https://hyperframes.heygen.com" lang="en">HyperFrames</a>（HeyGen 開源，Apache 2.0）用 HTML 寫畫面、輸出成 MP4。下面這支是這門課原本的預錄課第 0 堂，畫面是 HTML，旁白是 AI 合成的聲音。要裝在自己電腦上，搭配 Claude Code 這類 AI 工具使用。
        </p>
        <video class="example-video" controls preload="none" poster={url("/video/ai/hyperframes-example.jpg")} src={url("/video/ai/hyperframes-example.mp4")}></video>
      </div>
    </section>

    <section class="section how ideas" id="ideas">
      <div class="wrap">
        <h2>三個不太會過時的動作</h2>
        <dl>
          {
            aiRounds.map((r) => (
              <div>
                <dt>{r.idea}</dt>
                <dd>
                  第 {r.no} 輪會親眼看到。對應「{r.fluency}」。
                </dd>
              </div>
            ))
          }
        </dl>
        <p class="credit">
          這三個動作的整理，參考 <a href={aiFrameworkSource.url} lang="en">{aiFrameworkSource.name}</a> 的四項能力：描述、辨別、委派、盡責，由 Rick Dakan 與 Joseph Feller 提出。{aiFrameworkSource.credit}，以
          <a href={aiFrameworkSource.licenseUrl}>{aiFrameworkSource.license}</a> 釋出；這一頁改寫的內容依同樣的授權分享。工具會進步，所以說的是「不太會過時」，不是永遠不變。
        </p>
      </div>
    </section>

    <section class="section how bring kraft" id="bring">
      <div class="wrap">
        <h2>要帶什麼來</h2>
        <dl>
          {
            aiBring.map(([head, note]) => (
              <div>
                <dt>{head}</dt>
                <dd>{note}</dd>
              </div>
            ))
          }
        </dl>
        <p class="notice">{aiNotBring}</p>
        <p class="lede">能不能把資料交給 AI 工具，以醫院、學校與系所的規定為準。</p>
      </div>
    </section>

    <section class="section handout-dl" id="handout">
      <div class="wrap">
        <Art name="notebook" size={96} rotate={-6} class="pinned" />
        <h2>學習單</h2>
        <p class="lede">
          A4 五頁。第 1 頁是三輪要打的話，上課照著做；第 2 頁是五個題目，每一題的問法、第 2 輪檢查時可以問的問題和第 3 輪做簡報的第一句；第 3 頁是 HTML 簡報和 PPT 的比較、六個風格句；第 4 頁是「現在有哪些」的三張圖；第 5 頁留給你自己：你抓到的那一句、有一件事你不會交給 AI。不用交。
        </p>
        <div class="actions">
          <a class="btn btn-primary" href={url("/files/ai/handout.pdf")} download="AI課_學習單.pdf">下載 PDF（直接印）</a>
          <a class="btn btn-quiet" href={url("/files/ai/handout.docx")} download="AI課_學習單.docx">下載 Word 版（可打字）</a>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .cmp { width: 100%; max-width: 52rem; border-collapse: collapse; margin: 1rem 0 1.5rem; }
  .cmp th, .cmp td { border-bottom: 1.5px solid var(--ink); padding: 0.45rem 0.5rem; text-align: left; vertical-align: top; }
  .cmp tbody th { white-space: nowrap; }
  .style-grid { list-style: none; margin: 1rem 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr)); gap: 1.25rem; }
  .style-grid li { background: var(--card, #fff); border: 2px solid var(--ink); border-radius: 10px; padding: 0.75rem; }
  .style-grid img { width: 100%; height: auto; border-radius: 6px; display: block; }
  .style-grid h3 { margin: 0.6rem 0 0.2rem; }
  .style-grid small { margin-left: 0.5em; font-size: 0.75em; color: var(--muted); }
  .style-grid .fit { margin: 0; color: var(--muted); }
  .style-grid .sentence { margin: 0.4rem 0; font-size: 0.95em; }
  .style-grid .links { display: flex; gap: 1rem; margin: 0; }
  .example-video { display: block; width: 100%; max-width: 48rem; height: auto; aspect-ratio: 16 / 9; border: 2px solid var(--ink); border-radius: 8px; background: #000; margin: 1rem 0; }
  .topic-list {
    max-width: var(--measure);
    margin: 1rem 0 0;
    padding-left: 1.6em;
    display: grid;
    gap: 0.45rem;
  }
  .topic-list b {
    font-weight: 700;
  }
  .topic-list span {
    display: block;
    color: var(--muted);
    font-size: 0.92em;
  }
  .top {
    padding-block: clamp(2.5rem, 7vw, 5rem) clamp(1rem, 3vw, 2rem);
  }
  .sub {
    margin: 0.75rem 0 1rem;
    font-size: clamp(1.4rem, 3.4vw, 2.2rem);
    line-height: 1.4;
  }
  .top .lede {
    color: var(--ink);
  }
  .when {
    margin-top: 1rem;
    color: var(--red);
    font-weight: 700;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.75rem;
  }
  .lede {
    max-width: var(--measure);
  }
  .big {
    max-width: 22em;
    margin: 0.5rem 0 1rem;
    font-size: clamp(1.5rem, 3.6vw, 2.3rem);
    line-height: 1.35;
  }

  .round-list {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    border-top: 2px solid var(--ink);
  }
  .round-list > li {
    display: grid;
    grid-template-columns: 3.2rem minmax(0, 1fr);
    gap: 0 1rem;
    padding: 1.6rem 0;
    border-bottom: 1.5px solid var(--rule);
  }
  .round-list .no {
    color: var(--blue);
    font-size: 3rem;
    line-height: 1;
  }
  .round-list h3 {
    font-size: clamp(1.3rem, 2.6vw, 1.65rem);
    line-height: 1.35;
  }
  .round-list p,
  .round-list ul {
    max-width: var(--measure);
  }
  .change {
    margin-top: 0.35rem;
    color: var(--muted);
  }
  .change b,
  .idea b,
  .type b {
    display: block;
    font-size: 0.9375rem;
  }
  .change b {
    color: var(--muted);
  }
  .type {
    margin-top: 0.8rem;
    padding: 0.65rem 0.95rem;
    border: 2px dashed var(--pencil);
    border-radius: var(--wob-b);
    background: var(--card);
  }
  .type b {
    color: var(--marker-deep);
  }
  .round-list ul {
    margin: 0.8rem 0 0;
    padding-left: 1.2rem;
  }
  .round-list ul li {
    margin: 0.2rem 0;
  }
  .idea {
    margin-top: 0.9rem;
    font-size: 1.15rem;
    font-weight: 700;
  }
  .idea b {
    color: var(--green);
    font-weight: 700;
  }

  .how dl {
    margin-top: 1.25rem;
    border-top: 2px solid var(--ink);
  }
  .how dl > div {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 0.5rem clamp(1.5rem, 5vw, 4rem);
    padding: 1.3rem 0;
    border-bottom: 1.5px solid var(--rule);
  }
  .bring dl > div {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
  }
  .how dt {
    font-size: clamp(1.2rem, 2.3vw, 1.5rem);
    line-height: 1.4;
  }
  .how dd {
    max-width: var(--measure);
    color: var(--muted);
  }
  .credit {
    max-width: var(--measure);
    margin-top: 1.25rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .credit a {
    color: inherit;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
  .notice {
    max-width: var(--measure);
    margin: 1.25rem 0 0.5rem;
    font-weight: 700;
  }

  @media (max-width: 40rem) {
    .how dl > div,
    .bring dl > div {
      grid-template-columns: 1fr;
    }
    .round-list > li {
      grid-template-columns: 2.2rem minmax(0, 1fr);
    }
    .round-list .no {
      font-size: 2.2rem;
    }
  }
</style>
