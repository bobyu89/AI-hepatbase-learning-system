---
import Base from "../../../../layouts/Base.astro";
import "../../../../styles/handout.css";
import { aiCourse } from "../../../../data/ai-course";
import { url } from "../../../../lib/url";

const items: [string, [string, number][]][] = [
  ["跌倒病史（這次住院期間，或過去三個月內）", [["沒有", 0], ["有", 25]]],
  ["次要診斷（有兩個以上的醫學診斷）", [["沒有", 0], ["有", 15]]],
  ["行走輔具", [["不需要、臥床休息，或由護理人員協助", 0], ["使用拐杖、手杖或助行器", 15], ["扶著家具行走", 30]]],
  ["靜脈輸液或靜脈留置針", [["沒有", 0], ["有", 20]]],
  ["步態", [["正常、臥床休息，或坐輪椅", 0], ["虛弱", 10], ["不穩", 20]]],
  ["認知狀態", [["了解自己的活動能力", 0], ["高估自己的能力，或忘記自己的限制", 15]]],
];
---

<Base title={`備用講義｜${aiCourse.title}`} current="ai" description="實體課的備用講義：跌倒風險評估與 Morse 跌倒量表。練習用的示範講義。">
  <main class="handout">
    <div class="tools">
      <button type="button" class="btn btn-primary" onclick="window.print()">列印這一頁</button>
      <a class="btn btn-quiet" href={url("/courses/ai/workshop/")}>步驟單</a>
      <a class="btn btn-quiet" href={url("/courses/ai/")}>回課程介紹</a>
    </div>
    <article class="paper">
      <h1>跌倒風險評估：Morse 跌倒量表</h1>
      <p class="lede">{aiCourse.title}　實體課備用講義</p>
      <p class="notice">
        這是給課堂練習用的示範講義，用來練習「把講義交給 AI，再回講義查證」。它不是正式教材。量表的項目與分數是依一般教材常見的版本整理的，沒有逐字對照原始文獻；臨床使用請以你的課本與所屬機構的版本為準。
      </p>

      <h2>一、為什麼要評估</h2>
      <p>住院病人跌倒是常見的病人安全事件。評估的目的是提早找出風險比較高的病人，替他安排預防措施。量表只是工具，不能取代護理人員對病人的觀察。</p>

      <h2>二、六個評估項目</h2>
      <table>
        <thead>
          <tr><th>項目</th><th>情況</th><th class="num">分數</th></tr>
        </thead>
        <tbody>
          {
            items.map(([name, options], i) =>
              options.map(([label, score], k) => (
                <tr>
                  {k === 0 && (
                    <th rowspan={options.length} scope="row">
                      {i + 1}. {name}
                    </th>
                  )}
                  <td>{label}</td>
                  <td class="num">{score}</td>
                </tr>
              )),
            )
          }
        </tbody>
      </table>
      <p>六項分數相加，總分最低 0 分，最高 125 分。</p>

      <h2>三、分數怎麼看</h2>
      <p>分數越高，跌倒的風險越高。幾分以上算高風險，要依各單位的病人族群訂定，所以每家機構的切分點不一定相同。許多機構以 45 分作為高風險的切分點。課堂上請以老師或實習單位使用的版本為準。</p>

      <h2>四、什麼時候評估</h2>
      <p>常見的時機有四個：入院時、病情改變時、轉床或轉單位之後，以及發生跌倒之後。</p>

      <h2>五、練習用的虛構個案</h2>
      <p>
        王女士，七十多歲（虛構的個案）。過去三個月內在家跌倒過一次。有高血壓與糖尿病。平常使用助行器走路。目前手上有靜脈留置針。走路時步伐小、看起來虛弱。她清楚知道自己下床要有人陪。
      </p>
      <p>請照上面的表，算出她的總分。答案：25 + 15 + 15 + 20 + 10 + 0 = 85 分。</p>

      <h2>參考文獻</h2>
      <p class="ref">
        Morse, J. M., Black, C., Oberle, K., &amp; Donahue, P. (1989). A prospective study to identify the fall-prone patient. <i>Social Science &amp; Medicine, 28</i>(1), 81–86.{" "}
        <a href="https://doi.org/10.1016/0277-9536(89)90309-2">https://doi.org/10.1016/0277-9536(89)90309-2</a>
      </p>
    </article>
  </main>
</Base>
