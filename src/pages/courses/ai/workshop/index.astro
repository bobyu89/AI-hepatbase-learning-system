---
import Base from "../../../../layouts/Base.astro";
import "../../../../styles/handout.css";
import { aiCourse, aiWorkshopFlow, aiWorkshopGoal, aiReadingSheet } from "../../../../data/ai-course";
import { url } from "../../../../lib/url";

const min = (i: number) => aiWorkshopFlow[i][1];
const from = (i: number) => aiWorkshopFlow[i][2];
---

<Base title={`實體課步驟單｜${aiCourse.title}`} current="ai" description={`${aiCourse.title}實體課的步驟單：帶一篇論文，做出${aiWorkshopGoal}。`}>
  <main class="handout">
    <div class="tools">
      <a class="btn btn-primary" href={url("/files/ai/step-sheet.docx")} download="AI課_實體課步驟單.docx">下載 Word 版（可打字）</a>
      <a class="btn btn-quiet" href={url("/files/ai/step-sheet.pdf")} download="AI課_實體課步驟單.pdf">下載 PDF</a>
      <button type="button" class="btn btn-quiet" onclick="window.print()">列印這一頁</button>
      <a class="btn btn-quiet" href={url("/courses/ai/workshop/prep/")}>課前準備</a>
      <a class="btn btn-quiet" href={url("/courses/ai/workshop/paper/")}>示範論文</a>
      <a class="btn btn-quiet" href={url("/courses/ai/")}>回課程介紹</a>
    </div>
    <article class="paper">
      <h1>實體課步驟單</h1>
      <p class="lede">
        {aiCourse.title}　60 分鐘。照著做，下課時你會有{aiWorkshopGoal}。跟不上的時候，回到這張單子，從沒打勾的那一格接著做。
      </p>

      <section class="stage">
        <span class="n">1</span>
        <div>
          <h2>打開工具和論文</h2>
          <p class="meta">{min(0)} 分鐘</p>
          <ul>
            <li>登入你的 AI 工具，開一個新的對話</li>
            <li>打開你帶來的論文 PDF。沒帶的話，用預設的那一篇</li>
            <li>工具登不進去：先和旁邊的同學共用一台，下課再處理</li>
          </ul>
        </div>
      </section>

      <section class="stage">
        <span class="n">2</span>
        <div>
          <h2>先檢查：這篇論文能不能上傳</h2>
          <p class="meta">{min(1)} 分鐘　想再看一次：{from(1)}</p>
          <ul>
            <li>是開放取用的論文，或學校圖書館有授權</li>
            <li>是已經發表的論文，不是別人還沒發表的稿子</li>
            <li>檔案裡沒有病人或同學的個人資料</li>
          </ul>
          <p>有任何一格不確定，就改用預設的那一篇。</p>
        </div>
      </section>

      <section class="stage">
        <span class="n">3</span>
        <div>
          <h2>問第一次，再把話說清楚</h2>
          <p class="meta">{min(2)} 分鐘　想再看一次：{from(2)}</p>
          <ul>
            <li>先不上傳論文，只打下面這一句，看它回什麼</li>
          </ul>
          <p class="say"><b>先打這句</b>幫我摘要 <span class="blank"></span> 這篇論文。</p>
          <ul>
            <li>開一個新的對話，上傳論文，把任務、材料、格式都交代清楚</li>
          </ul>
          <p class="say">
            <b>再打這句，並上傳論文</b>
            我是護理系 <span class="blank"></span> 年級的學生。請只根據我上傳的這篇論文回答，論文沒寫的請說「論文沒有提到」。先用三句話告訴我，這篇在回答什麼問題。
          </p>
          <ul>
            <li>老師把第一句換成「我是護理系的老師」</li>
            <li>兩個答案比較，差在哪裡</li>
            <li>追問一次，例如：「用大二學生聽得懂的話再講一次。」</li>
          </ul>
        </div>
      </section>

      <section class="stage">
        <span class="n">4</span>
        <div>
          <h2>填出閱讀單的五格</h2>
          <p class="meta">{min(3)} 分鐘　想再看一次：{from(3)}</p>
          <p class="say">
            <b>一格一格問</b>
            請只根據這篇論文，回答：<span class="blank"></span>。並告訴我你是根據論文的哪一段。
          </p>
          <table>
            <thead>
              <tr><th>閱讀單</th><th>AI 的回答，用自己的話寫下來</th></tr>
            </thead>
            <tbody>
              {aiReadingSheet.map(([head, hint]) => (
                <tr>
                  <th scope="row">
                    {head} <small>（{hint}）</small>
                  </th>
                  <td>&nbsp;</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="stage">
        <span class="n">5</span>
        <div>
          <h2>查證：每一格挑一句，回原文核對</h2>
          <p class="meta">{min(4)} 分鐘　想再看一次：{from(4)}</p>
          <p>優先挑數字、研究設計的名稱，和講得很肯定的句子。</p>
          <table>
            <thead>
              <tr><th>AI 說的句子</th><th>原文在第幾頁、哪一段</th><th>一樣嗎</th></tr>
            </thead>
            <tbody>
              <tr><td>&nbsp;</td><td></td><td></td></tr>
              <tr><td>&nbsp;</td><td></td><td></td></tr>
              <tr><td>&nbsp;</td><td></td><td></td></tr>
            </tbody>
          </table>
          <ul>
            <li>原文找不到的句子，從閱讀單上劃掉</li>
            <li>原文寫「有關聯」，它寫成「有效」的地方，圈起來</li>
            <li>和原文不一樣的數字，照原文改</li>
          </ul>
        </div>
      </section>

      <section class="stage">
        <span class="n">6</span>
        <div>
          <h2>互看：和旁邊的同學交換</h2>
          <p class="meta">{min(5)} 分鐘　想再看一次：{from(5)}</p>
          <ul>
            <li>在他的閱讀單上，找一句他還沒查過的，幫他回原文對</li>
            <li>告訴他一個你看不懂的地方</li>
            <li>拿回自己的，照同學說的改一處</li>
          </ul>
        </div>
      </section>

      <section class="stage">
        <span class="n">7</span>
        <div>
          <h2>收尾：寫下你怎麼用的</h2>
          <p class="meta">{min(6)} 分鐘　想再看一次：{from(6)}</p>
          <ul>
            <li>我用的工具是 <span class="blank"></span></li>
            <li>我用它來做 <span class="blank"></span></li>
            <li>我自己查證和修改了 <span class="blank"></span></li>
            <li>今天學到、明天就會用的一個動作是 <span class="blank"></span></li>
          </ul>
          <p><b>如果你是老師，改寫這四句：</b></p>
          <ul>
            <li>我會把這個活動放進哪一門課 <span class="blank"></span></li>
            <li>我會指定學生讀的論文是 <span class="blank"></span></li>
            <li>我會要求學生交出的查證紀錄是 <span class="blank"></span></li>
            <li>我對學生使用 AI 的規定會寫成 <span class="blank"></span></li>
          </ul>
        </div>
      </section>
    </article>
  </main>
</Base>
