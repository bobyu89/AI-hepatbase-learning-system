<script>
  const root = document.querySelector<HTMLElement>("[data-live]");
  if (root) {
    const panels = [...root.querySelectorAll<HTMLElement>(".panel")];
    const count = root.querySelector<HTMLOutputElement>("[data-count]");
    let current = 0;
    const show = (i: number) => {
      current = Math.max(0, Math.min(panels.length - 1, i));
      panels[current].scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth", block: "start" });
    };
    const seen = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            current = panels.indexOf(e.target as HTMLElement);
            if (count) count.value = `${current + 1} / ${panels.length}`;
          }
        }
      },
      { threshold: 0.55 },
    );
    panels.forEach((p) => seen.observe(p));
    if (count) count.value = `1 / ${panels.length}`;
    root.querySelector("[data-next]")?.addEventListener("click", () => show(current + 1));
    root.querySelector("[data-prev]")?.addEventListener("click", () => show(current - 1));
    document.addEventListener("keydown", (e) => {
      const t = e.target as HTMLElement;
      if (t.closest("summary, a, button, input, textarea")) return;
      if (["ArrowRight", "ArrowDown", "PageDown", " "].includes(e.key)) {
        e.preventDefault();
        show(current + 1);
      } else if (["ArrowLeft", "ArrowUp", "PageUp"].includes(e.key)) {
        e.preventDefault();
        show(current - 1);
      }
    });
  }
</script>

