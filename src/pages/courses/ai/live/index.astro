---
import Base from "../../../../layouts/Base.astro";
import Art from "../../../../components/Art.astro";
import { aiCourse } from "../../../../data/ai-course";
import {
  aiSession,
  aiRounds,
  aiOpeningStats,
  aiTimeline,
  aiLandscape,
  aiLandscapeAsOf,
  aiBoards,
  aiBoardQuestions,
  aiPolicyStats,
  aiNames,
  aiAgenda,
  aiScenarios,
  aiFrameworkSource,
} from "../../../../data/ai-session";
import { url } from "../../../../lib/url";

const tilt = [-1.2, 0.8, -0.6, 1.1, -0.9];
---

<Base bare title={`現場投影｜${aiCourse.title}`} description={`${aiCourse.title}現場課的圖文頁：AI 的歷程、現在有哪些、怎麼看排行榜、四輪做法。`}>
  <main class="live" data-live>
    <nav class="live-nav" aria-label="投影控制">
      <a class="home" href={url("/courses/ai/")}>課程首頁</a>
      <button type="button" data-prev aria-label="上一頁">←</button>
      <output data-count aria-live="polite">1</output>
      <button type="button" data-next aria-label="下一頁">→</button>
    </nav>

    <section class="panel cover">
      <div class="inner">
        <h1>AI <span class="scribble">不只是聊天</span></h1>
        <p class="motto">{aiSession.motto}</p>
        <p class="meta">
          {aiCourse.workshopDate}{aiCourse.workshopPlace && `　${aiCourse.workshopPlace}`}
        </p>
        <p class="hint">按 → 或空白鍵往下，← 往上</p>
      </div>
    </section>

    <section class="panel">
      <div class="inner wide">
        <h2>今天怎麼走</h2>
        <ol class="agenda">
          {
            aiAgenda.map(([head, what, min]) => (
              <li>
                <b>{head}</b>
                <span>{what}</span>
                <small>{min}</small>
              </li>
            ))
          }
        </ol>
        <p class="take">不教哪一個 AI 比較好。只講不太會過時的東西。</p>
      </div>
    </section>

    <section class="panel">
      <div class="inner">
        <h2>問題已經不是「要不要用」</h2>
        <ul class="bars">
          {
            aiOpeningStats.bars.map(([label, n], i) => (
              <li class:list={{ low: i === 2 }}>
                <span class="label">{label}</span>
                <span class="track">
                  <i style={`--n:${n}`} />
                </span>
                <b>{n}%</b>
              </li>
            ))
          }
        </ul>
        <p class="take">幾乎人人都在用。把它寫的字直接交出去的，是少數。</p>
        <p class="src">
          <a href={aiOpeningStats.url}>{aiOpeningStats.source}</a>。這是英國的情況。
        </p>
      </div>
    </section>

    <section class="panel">
      <div class="inner wide">
        <h2>四年，三步</h2>
        <ol class="timeline">
          {
            aiTimeline.map(([year, what, human]) => (
              <li>
                <span class="year">{year}</span>
                <span class="what">{what}</span>
                {human && <span class="human">人在學：{human}</span>}
              </li>
            ))
          }
        </ol>
        <p class="take">先是會講話，再來會想一下再講，現在會自己動手做、做完自己檢查。</p>
      </div>
    </section>

    <section class="panel">
      <div class="inner wide">
        <h2>現在有哪些</h2>
        <p class="asof">查詢日期：{aiLandscapeAsOf}　這一頁下個月就過時了</p>
        <ul class="cards">
          {
            aiLandscape.map(([who, model, when, good], i) => (
              <li style={`--tilt:${tilt[i % tilt.length]}deg`} class:list={{ open: i === aiLandscape.length - 1 }}>
                <b class="who">{who}</b>
                <span class="model">{model}</span>
                <span class="when">{when}</span>
                <span class="good">{good}</span>
              </li>
            ))
          }
        </ul>
        <p class="src">整理自第三方的彙整網站，各站數字不一致。實際排名以 arena.ai 與 artificialanalysis.ai 當天的榜單為準。</p>
      </div>
    </section>

    <section class="panel">
      <div class="inner wide">
        <h2>同一個月，兩個榜，兩個第一名</h2>
        <ul class="boards">
          {
            aiBoards.map(([board, measures, first]) => (
              <li>
                <span class="board">{board}</span>
                <span class="measures">量的是：{measures}</span>
                <span class="first">
                  第一名 <b>{first}</b>
                </span>
              </li>
            ))
          }
        </ul>
        <ol class="ask">
          {aiBoardQuestions.map((q) => <li>{q}</li>)}
        </ol>
        <p class="take">沒有一個榜在量「它在你的專業上會不會講錯」。那個只有你能量。</p>
      </div>
    </section>

    <section class="panel kraft">
      <div class="inner">
        <Art name="magnifier" size={110} rotate={8} class="pin" />
        <h2>今天只做一件事，做四次</h2>
        <p class="task">{aiSession.task}</p>
        <ul class="fill">
          <li>我最懂的一個概念是 <span class="blank"></span></li>
          <li>我要講給 <span class="blank"></span> 聽</li>
        </ul>
        <p class="warn">題目裡不要有任何一位病人的資料。</p>
      </div>
    </section>

    {
      aiRounds.map((r) => (
        <section class="panel round">
          <div class="inner wide">
            <p class="round-no">
              <span>{r.no}</span> 第 {r.no} 輪　約 {r.min} 分鐘
            </p>
            <h2>{r.title}</h2>
            <p class="change">
              <b>這一輪只改</b>
              {r.change}
            </p>
            {r.type.map(([label, text]) => (
              <p class="type">
                <b>{label}</b>
                {text}
              </p>
            ))}
            <ul class="todo">
              {r.todo.map((t) => <li>{t}</li>)}
            </ul>
            {r.no < 4 ? (
              <details class="idea">
                <summary>這一輪看到的觀念（做完再打開）</summary>
                <p>{r.idea}</p>
                <p class="metaphor">{r.metaphor}</p>
              </details>
            ) : (
              <p class="nextup">下一頁：三個情境，舉手表決。</p>
            )}
          </div>
        </section>
      ))
    }

    <section class="panel round vote-panel">
      <div class="inner wide">
        <h2>這個可以貼給 AI 嗎？</h2>
        <p class="vote">可以的舉手。不可以的舉手。要看情況的舉手。</p>
        <ol class="scenarios">
          {
            aiScenarios.map(([what, say]) => (
              <li>
                <details>
                  <summary>{what}</summary>
                  <p>{say}</p>
                </details>
              </li>
            ))
          }
        </ol>
        <p class="src">能不能貼，以醫院、學校與系所的規定為準。查不到規定，就當作不能貼。</p>
        <details class="idea">
          <summary>這一輪看到的觀念（做完再打開）</summary>
          <p>{aiRounds[3].idea}</p>
          <p class="metaphor">{aiRounds[3].metaphor}</p>
        </details>
      </div>
    </section>

    <section class="panel">
      <div class="inner">
        <h2>規定還沒跟上</h2>
        <ul class="bars">
          {
            aiPolicyStats.bars.map(([label, n], i) => (
              <li class:list={{ low: i === 1 }}>
                <span class="label">{label}</span>
                <span class="track">
                  <i style={`--n:${n}`} />
                </span>
                <b>{n}%</b>
              </li>
            ))
          }
        </ul>
        <blockquote>
          <p>{aiPolicyStats.quote}</p>
          <footer>{aiPolicyStats.quoteSource}</footer>
        </blockquote>
        <p class="src">
          <a href={aiPolicyStats.url}>{aiPolicyStats.source}</a>。這是美國中小學的情況。
        </p>
      </div>
    </section>

    <section class="panel">
      <div class="inner wide">
        <h2>今年的新說法：loop</h2>
        <p class="lead">不再由你一句一句問。設計一個流程，讓它做完自己檢查，不對就自己改，改到好為止。</p>
        <ol class="loop" aria-label="目標，然後反覆做、檢查、修正，直到可以停">
          <li class="you">
            <b>目標</b>
            <span>你訂的</span>
          </li>
          <li class="cycle">
            <ol>
              <li>
                <b>做</b>
                <span>它做</span>
              </li>
              <li class="check">
                <b>檢查</b>
                <span>以前是你。今天第 2 輪就是這一步</span>
              </li>
              <li>
                <b>修正</b>
                <span>不對就再來一次</span>
              </li>
            </ol>
            <p class="again">沒過，再跑一圈</p>
          </li>
          <li class="you">
            <b>停</b>
            <span>什麼時候算完成，你訂的</span>
          </li>
        </ol>
        <p class="take">它可以自己跑很多圈。目標、什麼時候停、出錯誰負責，還是你的。</p>
      </div>
    </section>

    <section class="panel">
      <div class="inner wide">
        <h2>名詞每年換，動作沒有換</h2>
        <table class="names">
          <thead>
            <tr><th>這幾年流行的說法</th><th>它在問的問題</th><th>就是今天的哪一輪</th></tr>
          </thead>
          <tbody>
            {
              aiNames.map(([name, ask, round]) => (
                <tr>
                  <th scope="row">{name}</th>
                  <td>{ask}</td>
                  <td class="round-cell">{round}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="take">以前是你自己檢查，以後是你設計讓它自己檢查。目標、什麼時候算完成、出錯誰負責，還是你的。</p>
      </div>
    </section>

    <section class="panel cover">
      <div class="inner">
        <h2>四個不太會過時的動作</h2>
        <ol class="four">
          {aiRounds.map((r) => <li>{r.idea}</li>)}
        </ol>
        <p class="motto">{aiSession.motto}</p>
        <p class="src">
          四個動作的整理參考 <a href={aiFrameworkSource.url} lang="en">{aiFrameworkSource.name}</a>（Rick Dakan 與 Joseph Feller 提出；{aiFrameworkSource.credit}，
          <a href={aiFrameworkSource.licenseUrl}>{aiFrameworkSource.license}</a>）。這一頁依同樣的授權分享。
        </p>
      </div>
    </section>
  </main>
</Base>

<script>
  const root = document.querySelector<HTMLElement>("[data-live]");
  if (root) {
    const panels = [...root.querySelectorAll<HTMLElement>(".panel")];
    const count = root.querySelector<HTMLOutputElement>("[data-count]");
    let current = 0;
    const show = (i: number) => {
      current = Math.max(0, Math.min(panels.length - 1, i));
      panels[current].scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth", block: "start" });
    };
    const seen = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            current = panels.indexOf(e.target as HTMLElement);
            if (count) count.value = `${current + 1} / ${panels.length}`;
          }
        }
      },
      { threshold: 0.55 },
    );
    panels.forEach((p) => seen.observe(p));
    if (count) count.value = `1 / ${panels.length}`;
    root.querySelector("[data-next]")?.addEventListener("click", () => show(current + 1));
    root.querySelector("[data-prev]")?.addEventListener("click", () => show(current - 1));
    document.addEventListener("keydown", (e) => {
      const t = e.target as HTMLElement;
      if (t.closest("summary, a, button, input, textarea")) return;
      if (["ArrowRight", "ArrowDown", "PageDown", " "].includes(e.key)) {
        e.preventDefault();
        show(current + 1);
      } else if (["ArrowLeft", "ArrowUp", "PageUp"].includes(e.key)) {
        e.preventDefault();
        show(current - 1);
      }
    });
  }
</script>

<style>
  :global(html:has(.live)) {
    scroll-snap-type: y mandatory;
  }
  .live {
    --big: clamp(2rem, 4.5vw, 4rem);
    --mid: clamp(1.4rem, 2.8vw, 2.5rem);
    --body: clamp(1.15rem, 2vw, 1.9rem);
  }
  .panel {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding: clamp(3.2rem, 6vh, 4.5rem) clamp(0.75rem, 2.5vw, 2.5rem) clamp(0.75rem, 2vh, 2rem);
    scroll-snap-align: start;
  }
  .inner {
    position: relative;
    width: min(100%, 68rem);
    margin-inline: auto;
    padding: clamp(1.25rem, 3.2vh, 2.75rem) clamp(1.5rem, 4vw, 3.25rem);
    background: var(--grain), var(--surface);
    border-radius: 2px;
    box-shadow: var(--shadow);
    font-size: var(--body);
    line-height: 1.6;
  }
  .inner.wide {
    width: min(100%, 88rem);
  }
  .panel:nth-of-type(odd) .inner {
    rotate: -0.3deg;
  }
  .panel:nth-of-type(even) .inner {
    rotate: 0.25deg;
  }
  .panel.kraft .inner {
    background: var(--grain), var(--kraft);
  }
  .panel.cover .inner {
    background: none;
    box-shadow: none;
    rotate: 0deg;
  }
  h1 {
    font-size: clamp(3rem, 9vw, 7rem);
    line-height: 1.1;
  }
  h2 {
    font-size: var(--big);
    line-height: 1.25;
    margin-bottom: 0.45em;
  }
  .motto {
    margin-top: 0.6em;
    font-size: clamp(1.6rem, 4vw, 3rem);
    line-height: 1.35;
  }
  .meta {
    margin-top: 1.2em;
    color: var(--red);
    font-weight: 700;
  }
  .hint {
    margin-top: 2.5em;
    color: var(--muted);
    font-size: clamp(1rem, 1.4vw, 1.3rem);
  }
  .take {
    margin-top: 1.1em;
    font-size: var(--mid);
    font-weight: 700;
    line-height: 1.45;
  }
  .src,
  .asof {
    margin-top: 1em;
    color: var(--muted);
    font-size: clamp(0.9rem, 1.3vw, 1.25rem);
    line-height: 1.5;
  }
  .asof {
    margin-top: -0.4em;
    margin-bottom: 1em;
    color: var(--red);
  }
  .src a {
    color: inherit;
    text-underline-offset: 0.2em;
  }

  /* 長條 */
  .bars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }
  .bars li {
    display: grid;
    grid-template-columns: minmax(8em, 14em) minmax(0, 1fr) 3.6em;
    gap: 0.9rem;
    align-items: center;
  }
  .bars .track {
    height: 1.7em;
    border: 2px solid var(--ink);
    border-radius: var(--wob-a);
    background: var(--card);
    overflow: hidden;
  }
  .bars i {
    display: block;
    width: calc(var(--n) * 1%);
    height: 100%;
    background: var(--blue);
  }
  .bars .low i {
    background: var(--marker);
  }
  .bars b {
    font-size: var(--mid);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  /* 時間軸 */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0.9rem;
    border-top: 3px solid var(--ink);
  }
  .timeline li {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.45rem;
    padding-top: 1.1rem;
    font-size: clamp(1.05rem, 1.7vw, 1.65rem);
    line-height: 1.4;
  }
  .timeline li::before {
    content: "";
    position: absolute;
    top: -0.55rem;
    left: 0;
    width: 0.9rem;
    height: 0.9rem;
    border: 3px solid var(--ink);
    border-radius: 50%;
    background: var(--surface);
  }
  .timeline li:last-child::before {
    background: var(--marker);
  }
  .timeline .year {
    color: var(--blue);
    font-size: var(--mid);
    line-height: 1.1;
  }
  .timeline .human {
    padding: 0.35rem 0.5rem;
    background: var(--sticky);
    font-weight: 700;
    rotate: -1deg;
  }

  /* 廠商卡 */
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.9rem;
  }
  .cards li {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    padding: 1.6rem 0.9rem 1rem;
    background:
      linear-gradient(var(--rule-red), var(--rule-red)) 0 1.1rem / 100% 2px no-repeat,
      var(--card);
    box-shadow: var(--shadow);
    rotate: var(--tilt, 0deg);
    font-size: clamp(1.05rem, 1.65vw, 1.6rem);
    line-height: 1.4;
  }
  .cards li.open {
    background: var(--sticky);
  }
  .cards .who {
    color: var(--blue);
    font-size: var(--mid);
    line-height: 1.2;
  }
  .cards .model {
    font-weight: 700;
  }
  .cards .when {
    color: var(--muted);
    font-size: 0.9em;
  }

  /* 兩個榜 */
  .boards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.2rem;
  }
  .boards li {
    display: grid;
    gap: 0.3rem;
    padding: 1.1rem 1.3rem;
    border: 2px solid var(--ink);
    border-radius: var(--wob-b);
    background: var(--card);
  }
  .boards .board {
    font-size: var(--mid);
    line-height: 1.25;
  }
  .boards .measures {
    color: var(--muted);
  }
  .boards .first b {
    color: var(--marker-deep);
    font-size: var(--mid);
  }
  .ask {
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 2.2rem;
    counter-reset: ask;
    font-size: var(--mid);
  }
  .ask li {
    counter-increment: ask;
  }
  .ask li::before {
    content: counter(ask) "　";
    color: var(--blue);
  }

  /* 任務 */
  .pin {
    position: absolute;
    right: -1rem;
    top: -2.2rem;
  }
  .task {
    font-size: var(--big);
    line-height: 1.3;
  }
  .fill {
    margin: 0.8rem 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--mid);
    line-height: 1.8;
  }
  .blank {
    display: inline-block;
    min-width: 6em;
    border-bottom: 2px solid var(--ink);
  }
  .warn {
    margin-top: 1rem;
    font-weight: 700;
  }

  /* 今天怎麼走 */
  .agenda {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 2.2fr 1fr;
    gap: 1.1rem;
    counter-reset: agenda;
  }
  .agenda li {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    padding: 1.1rem 1.2rem;
    border: 2px solid var(--ink);
    border-radius: var(--wob-b);
    background: var(--card);
    counter-increment: agenda;
  }
  .agenda li:nth-child(2) {
    background: var(--sticky);
  }
  .agenda b {
    font-size: var(--mid);
    line-height: 1.25;
  }
  .agenda b::before {
    content: counter(agenda) "　";
    color: var(--blue);
  }
  .agenda small {
    color: var(--muted);
    font-size: 0.85em;
  }

  /* 三個情境 */
  .vote {
    color: var(--muted);
    margin-bottom: 0.8rem;
  }
  .scenarios {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    counter-reset: sc;
  }
  .scenarios li {
    counter-increment: sc;
    padding: 0.8rem 1rem;
    background:
      linear-gradient(var(--rule-red), var(--rule-red)) 0 0.8rem / 100% 2px no-repeat,
      var(--card);
    box-shadow: var(--shadow);
  }
  .vote-panel .vote {
    margin-bottom: 0.5rem;
  }
  .vote-panel .src {
    margin-top: 0.6rem;
  }
  .scenarios summary {
    cursor: pointer;
    list-style: none;
    font-size: clamp(1.2rem, min(2.1vw, 3.5vh), 2rem);
    line-height: 1.3;
    padding-top: 0.4rem;
  }
  .scenarios summary::-webkit-details-marker {
    display: none;
  }
  .scenarios summary::before {
    content: counter(sc);
    display: block;
    color: var(--blue);
    font-size: 1.6em;
    line-height: 1;
  }
  .scenarios details p {
    margin-top: 0.45rem;
    padding-top: 0.45rem;
    font-size: 0.9em;
    line-height: 1.4;
    border-top: 2px dashed var(--pencil);
    color: var(--marker-deep);
    font-weight: 700;
  }
  .nextup {
    margin-top: 1rem;
    color: var(--green);
    font-weight: 700;
  }
