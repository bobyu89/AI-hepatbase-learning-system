---
import Base from "../../../../layouts/Base.astro";
import Art from "../../../../components/Art.astro";
import { aiCourse } from "../../../../data/ai-course";
import {
  aiSession,
  aiRounds,
  aiOpeningStats,
  aiTimeline,
  aiLandscapeAsOf,
  aiIndex,
  aiIndexSource,
  aiCost,
  aiHealth,
  aiFamilies,
  aiEffort,
  aiProgress,
  aiHalluc,
  aiBoards,
  aiBoardQuestions,
  aiPolicyStats,
  aiNames,
  aiAgenda,
  aiScenarios,
  aiTopics,
  aiStyles,
  aiStylesSource,
  aiCompare,
  aiRoundPages,
  aiRoundFrame,
  aiSessionFrame,
  aiFrameworkSource,
} from "../../../../data/ai-session";
import { url } from "../../../../lib/url";

const tilt = [-1.2, 0.8, -0.6, 1.1, -0.9];

// 分數 vs 成本的散點圖：x 用對數刻度（0.4 到 40 美元），y 是綜合分數（30 到 70）。
const SW = 1000, SH = 470, PL = 70, PR = 30, PT = 20, PB = 60;
const sx = (usd: number) => PL + ((Math.log10(usd) - Math.log10(0.4)) / (Math.log10(40) - Math.log10(0.4))) * (SW - PL - PR);
const sy = (n: number) => PT + ((70 - n) / 40) * (SH - PT - PB);
const scoreOf = (m: string) => aiIndex.find(([name]) => name === m)?.[2] ?? 0;
// 同樣的錢裡分數最高的那幾個（由便宜到貴，分數一路往上）。
const pareto = ["DeepSeek V4.1 Flash", "GPT-6.2 Sol", "GPT-6.2 Astra", "Claude Fable 5.2"];
// 標籤位置：[dx, dy, 對齊]
const labelAt: Record<string, [number, number, "start" | "end" | "middle"]> = {
  "Claude Fable 5.2": [-12, -10, "end"],
  "GPT-6.2 Astra": [-12, -10, "end"],
  "Gemini 4 Neon": [-8, 30, "end"],
  "Claude Opus 5.5": [12, 6, "start"],
  "GPT-6.2 Sol": [0, -16, "middle"],
  "Kimi K3.1 Pro": [-12, -6, "end"],
  "Qwen4 Max": [-12, 14, "end"],
  "Muse Wonder": [12, 5, "start"],
  "Grok 4.7": [12, 5, "start"],
  "DeepSeek V4.1 Flash": [12, 5, "start"],
  "GLM-5.3": [12, 5, "start"],
};
const ticksX = [0.5, 1, 2, 5, 10, 20];
const ticksY = [30, 40, 50, 60, 70];

// 三家能力指數隨時間：x 是距 2022-11 的月數（0–48），y 是指數（75–375）。
const PW = 1000, PH = 430, QL = 60, QR = 30, QT = 15, QB = 50;
const px = (m: number) => QL + (m / 48) * (PW - QL - QR);
const py = (v: number) => QT + ((375 - v) / 300) * (PH - QT - QB);
const stepPath = (pts: [number, number][]) =>
  pts.map(([m, v], i) => (i === 0 ? `M${px(m)},${py(v)}` : `H${px(m)}V${py(v)}`)).join("");
const yearTicks: [number, string][] = [[2, "2023"], [14, "2024"], [26, "2025"], [38, "2026"]];
---

<Base bare title={`現場投影｜${aiCourse.title}`} description={`${aiCourse.title}現場課的圖文頁：AI 的歷程、現在有哪些、怎麼看排行榜、三輪做法。`}>
  <main class="live" data-live>
    <nav class="live-nav" aria-label="投影控制">
      <a class="home" href={url("/courses/ai/")}>課程首頁</a>
      <a class="home" href={url("/files/ai/handout.pdf")} download="AI課_學習單.pdf">學習單</a>
      <button type="button" data-prev aria-label="上一頁">←</button>
      <output data-count aria-live="polite">1</output>
      <button type="button" data-next aria-label="下一頁">→</button>
    </nav>

    <section class="panel cover">
      <div class="inner">
        <h1>AI <span class="scribble">不只是聊天</span></h1>
        <p class="motto">{aiSession.motto}</p>
        <p class="meta">
          {aiCourse.workshopDate}{aiCourse.workshopPlace && `　${aiCourse.workshopPlace}`}
        </p>
        <p class="hint">按 → 或空白鍵往下，← 往上</p>
      </div>
    </section>

    <section class="panel">
      <div class="inner wide">
        <h2>今天怎麼走</h2>
        <ol class="agenda">
          {
            aiAgenda.map(([head, what, min]) => (
              <li>
                <b>{head}</b>
                <span>{what}</span>
                <small>{min}</small>
              </li>
            ))
          }
        </ol>
        <p class="take">不教哪一個 AI 比較好。只講不太會過時的東西。</p>
      </div>
    </section>

    <section class="panel">
      <div class="inner">
        <h2>問題已經不是「要不要用」</h2>
        <ul class="bars">
          {
            aiOpeningStats.bars.map(([label, n], i) => (
              <li class:list={{ low: i === 2 }}>
                <span class="label">{label}</span>
                <span class="track">
                  <i style={`--n:${n}`} />
                </span>
                <b>{n}%</b>
              </li>
            ))
          }
        </ul>
        <p class="take">幾乎人人都在用。把它寫的字直接交出去的，是少數。</p>
        <p class="src">
          <a href={aiOpeningStats.url}>{aiOpeningStats.source}</a>。這是英國的情況。
        </p>
      </div>
    </section>

    <section class="panel">
      <div class="inner wide">
        <h2>四年，三步</h2>
        <ol class="timeline">
          {
            aiTimeline.map(([year, what, human]) => (
              <li>
                <span class="year">{year}</span>
                <span class="what">{what}</span>
                {human && <span class="human">人在學：{human}</span>}
              </li>
            ))
          }
        </ol>
        <p class="take">先是會講話，再來會想一下再講，現在會自己動手做、做完自己檢查。</p>
      </div>
    </section>

    <section class="panel">
      <div class="inner wide">
        <h2>三家輪流領先，現在幾乎並列</h2>
        <p class="asof">三家最強模型的能力指數，2022 年 11 月到 2026 年 11 月，越上越強</p>
        <svg class="scatter progress" viewBox={`0 0 ${PW} ${PH}`} role="img" aria-label="OpenAI、Anthropic、Google 能力指數隨時間的變化">
          {[100, 150, 200, 250, 300, 350].map((t) => (
            <g>
              <line x1={QL} x2={PW - QR} y1={py(t)} y2={py(t)} class="grid" />
              <text x={QL - 10} y={py(t) + 6} text-anchor="end" class="tick">{t}</text>
            </g>
          ))}
          {yearTicks.map(([m, y]) => (
            <text x={px(m)} y={PH - QB + 30} text-anchor="middle" class="tick">{y}</text>
          ))}
          {aiProgress.map((f) => {
            const last = f.pts[f.pts.length - 1];
            return (
              <g>
                <title>{`${f.who}：最近約 ${last[1]}`}</title>
                <path d={stepPath(f.pts)} fill="none" stroke={f.color} stroke-width="3" />
                {f.pts.map(([m, v]) => <rect x={px(m) - 4} y={py(v) - 4} width="8" height="8" fill={f.color} />)}
              </g>
            );
          })}
          {aiProgress.map((f, i) => (
            <g>
              <rect x={QL + 20} y={QT + 8 + i * 30} width="22" height="6" fill={f.color} />
              <text x={QL + 52} y={QT + 18 + i * 30} class="who" fill={f.color}>{f.who}</text>
            </g>
          ))}
        </svg>
        <p class="take">以前 OpenAI 領先；現在三家幾乎並列，第一名幾週就換人。</p>
        <p class="src">依 Artificial Analysis Progress Index v1（各家最強的推理強度）的圖描繪，數值是約略值。</p>
      </div>
    </section>

    <section class="panel">
      <div class="inner wide">
        <h2>現在有哪些：誰考得最好</h2>
        <p class="asof">綜合考試分數，越高越好　查詢日期：{aiLandscapeAsOf}　下個月就過時了</p>
        <ol class="hbars" aria-label="綜合考試分數">
          {
            aiIndex.map(([model, who, n, tag]) => (
              <li class:list={[tag]} title={`${who} ${model}：${n} 分`}>
                <span class="name">
                  <small>{who}</small>
                  {model}
                  {tag === "open" && <em>開放權重</em>}
                  {tag === "noapi" && <em>沒有公開 API</em>}
                </span>
                <span class="track">
                  <i style={`--w:${(n / 65) * 100}%`} />
                </span>
                <b>{n}</b>
              </li>
            ))
          }
        </ol>
        <p class="src">
          資料：<a href={aiIndexSource.url} lang="en">{aiIndexSource.name}</a>，9 項測驗合成的分數。只量它考題答得多好，不量它在你的專業上會不會講錯。
        </p>
      </div>
    </section>

    <section class="panel">
      <div class="inner wide">
        <h2>同一家，也有大中小</h2>
        <p class="asof">長條越長，綜合分數越高。貼著「免費」的，是免費版用得到的</p>
        <div class="fams">
          {
            aiFamilies.map((f) => (
              <div class="fam">
                <b class="fam-who">{f.who}</b>
                <ul>
                  {f.models.map((m) => (
                    <li class:list={{ free: m.free }}>
                      <span class="fam-name">{m.name}</span>
                      <span class="fam-track">
                        <i style={`--w:${(m.score / 65) * 100}%`} />
                      </span>
                      {m.free ? <em>免費</em> : <span />}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
        <p class="take">覺得「AI 好笨」之前，先看你用的是哪一個。</p>
        <p class="src">長度依 artificialanalysis.ai 綜合分數（{aiLandscapeAsOf}）。免費版用得到哪些，各家常調整，以官方方案頁為準。</p>
      </div>
    </section>

    <section class="panel">
      <div class="inner wide">
        <h2>同一個模型，想久一點就不一樣</h2>
        <p class="asof">每一列是一個模型。左邊的點是「想最少」，右邊的點是「想最久」；越右分數越高</p>
        <ul class="effort-chart">
          {
            aiEffort.map(([who, m, vals], i) => {
              const v = vals.filter((n) => n > 0);
              const lo = Math.min(...v), hi = Math.max(...v);
              const x = (n: number) => `${(n / 70) * 100}%`;
              return (
                <li class:list={{ gap: i > 0 && aiEffort[i - 1][0] !== who }}>
                  <span class="name">
                    <small>{who}</small> {m}
                  </span>
                  <span class="lane">
                    <i class="span" style={`left:${x(lo)};width:calc(${x(hi)} - ${x(lo)})`} />
                    {v.map((n, k) => (
                      <i class="dot" style={`left:${x(n)};--k:${k / Math.max(1, v.length - 1)}`} />
                    ))}
                  </span>
                </li>
              );
            })
          }
        </ul>
        <p class="legend-line"><i class="dot lo" /> 想最少　<i class="dot hi" /> 想最久</p>
        <p class="take">「思考」按鈕是類似的設計：想久一點分數較高，但比較慢。</p>
        <p class="src">依 artificialanalysis.ai 三家模型頁的綜合分數畫成（{aiLandscapeAsOf}），推理強度分低到最高五檔。</p>
      </div>
    </section>

    <section class="panel">
      <div class="inner wide">
        <h2>分數高的，也比較貴</h2>
        <p class="asof">橫軸：做一題的平均成本（美元，越右越貴）　縱軸：綜合考試分數（越上越好）</p>
        <svg class="scatter" viewBox={`0 0 ${SW} ${SH}`} role="img" aria-label="綜合分數和每題成本的散點圖">
          {ticksY.map((t) => (
            <g>
              <line x1={PL} x2={SW - PR} y1={sy(t)} y2={sy(t)} class="grid" />
              <text x={PL - 10} y={sy(t) + 5} text-anchor="end" class="tick">{t}</text>
            </g>
          ))}
          {ticksX.map((t) => (
            <text x={sx(t)} y={SH - PB + 26} text-anchor="middle" class="tick">${t}</text>
          ))}
          <polyline
            class="pareto"
            points={pareto.map((m) => `${sx(aiCost.find(([n]) => n === m)![2])},${sy(scoreOf(m))}`).join(" ")}
          />
          {aiCost.map(([model, who, usd]) => {
            const [dx, dy, anchor] = labelAt[model] ?? [12, 5, "start"];
            const on = pareto.includes(model);
            return (
              <g class:list={["pt", { on }]}>
                <title>{`${who} ${model}：${scoreOf(model)} 分，每題 ${usd.toFixed(2)} 美元`}</title>
                <circle cx={sx(usd)} cy={sy(scoreOf(model))} r="9" />
                <text x={sx(usd) + dx} y={sy(scoreOf(model)) + dy} text-anchor={anchor}>{model}</text>
              </g>
            );
          })}
        </svg>
        <p class="take">橘線是同樣的錢裡分數最高的。多 8 分，貴 26 倍。</p>
        <p class="src">資料：<a href={aiIndexSource.url} lang="en">artificialanalysis.ai</a>，{aiLandscapeAsOf}查詢。成本是用 API 計費，不是網頁版的月費。</p>
      </div>
    </section>

    <section class="panel">
      <div class="inner wide">
        <h2>換一份考卷：醫療</h2>
        <p class="asof">Healthcare & Medical Index，越高越好。右邊小字是剛剛的綜合分數</p>
        <ol class="hbars health" aria-label="醫療分數">
          {
            aiHealth.map(([model, who, n, overall]) => (
              <li title={`${who} ${model}：醫療 ${n} 分（綜合 ${overall} 分）`}>
                <span class="name">
                  <small>{who}</small>
                  {model}
                </span>
                <span class="track">
                  <i style={`--w:${(n / 65) * 100}%`} />
                </span>
                <b>
                  {n}<small class="was">{overall}</small>
                </b>
              </li>
            ))
          }
        </ol>
        <p class="take">換成醫療的考卷，排名就變了。看排行榜，先看它考什麼。</p>
        <p class="src">資料：artificialanalysis.ai，{aiLandscapeAsOf}查詢。分數高不代表在你的病房不會講錯。</p>
      </div>
    </section>

    <section class="panel">
      <div class="inner wide">
        <h2>不會的時候，敢不敢編</h2>
        <p class="asof">3,000 題知識題。藍：答對率。橘：不會的題目裡，硬給錯答案、不說「不知道」的比例</p>
        <ol class="pairs" aria-label="答對率與亂編率">
          {
            aiHalluc.map(([who, model, ok, bad], i) => (
              <li class:list={{ gap: i > 0 && aiHalluc[i - 1][0] !== who }} title={`${model}：答對 ${ok}%，亂編 ${bad}%`}>
                <span class="name">
                  <small>{who}</small>
                  {model}
                </span>
                <span class="two">
                  <span class="bar ok"><i style={`--w:${ok}%`} /><b>{ok}%</b></span>
                  <span class="bar bad"><i style={`--w:${bad}%`} /><b>{bad}%</b></span>
                </span>
              </li>
            ))
          }
        </ol>
        <p class="take">Gemini 比較會說「不知道」；Claude、GPT 答得多，也比較敢編。</p>
        <p class="src">資料：artificialanalysis.ai AA-Omniscience v1.1，{aiLandscapeAsOf}。免費版的 GPT-6 Luna，不會的題目近八成會硬答。所以第 2 輪要你當考官。</p>
      </div>
    </section>

    <section class="panel">
      <div class="inner wide">
        <h2>同一個月，兩個榜，兩個第一名</h2>
        <ul class="boards">
          {
            aiBoards.map(([board, measures, first]) => (
              <li>
                <span class="board">{board}</span>
                <span class="measures">量的是：{measures}</span>
                <span class="first">
                  第一名 <b>{first}</b>
                </span>
              </li>
            ))
          }
        </ul>
        <ol class="ask">
          {aiBoardQuestions.map((q) => <li>{q}</li>)}
        </ol>
        <p class="take">沒有一個榜在量「它在你的專業上會不會講錯」。那個只有你能量。</p>
      </div>
    </section>

    <section class="panel kraft start">
      <div class="inner wide">
        <Art name="magnifier" size={110} rotate={8} class="pin" />
        <h2>今天只做一件事，做三輪</h2>
        <p class="task">{aiSession.task}</p>
        <p class="warn">題目裡不要有任何一位病人的資料。</p>
        <dl class="frame">
          <div>
            <dt>今天的目標</dt>
            <dd>{aiSessionFrame.goal}</dd>
          </div>
          <div>
            <dt>下課時你會有</dt>
            <dd>{aiSessionFrame.have.join("、")}。</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="panel">
      <div class="inner wide">
        <h2>先下載學習單</h2>
        <div class="get">
          <img class="qr" src={url("/files/ai/handout-qr.svg")} alt="學習單下載頁的 QR code" width="240" height="240" />
          <div>
            <p class="lead">用手機掃，或在瀏覽器打開課程網站，按最上面的「下載學習單」。</p>
            <p class="url">bobyu89.github.io/AI-hepatbase-learning-system/courses/ai</p>
            <p class="get-btns">
              <a class="btn btn-primary" href={url("/files/ai/handout.pdf")} download="AI課_學習單.pdf">下載學習單（PDF）</a>
              <a class="btn btn-quiet" href={url("/files/ai/handout.docx")} download="AI課_學習單.docx">Word 版（可以直接打字）</a>
            </p>
            <p class="note">五頁：三輪要打的話、五個題目、HTML 簡報和風格、現在有哪些、帶回去的一頁。下課帶走，不用交。</p>
          </div>
        </div>
      </div>
    </section>

    <section class="panel kraft">
      <div class="inner wide">
        <h2>五個題目，挑一個</h2>
        <ol class="topics">
          {
            aiTopics.map((t) => (
              <li>
                <b>{t.title}</b>
                <span>{t.use}</span>
              </li>
            ))
          }
        </ol>
        <p class="warn">選你最熟的那一題，等一下你要當它的考官。每一題的兩種問法都在學習單第 2 頁。</p>
      </div>
    </section>

    {
      aiRounds.map((r) =>
        aiRoundPages[r.no].map((pg, i, all) => (
          <section class:list={["panel", "round", { first: i === 0 }]}>
            <div class="inner wide">
              <p class="round-no">
                <span>{r.no}</span> 第 {r.no} 輪　{i === 0 ? `約 ${r.min} 分鐘` : `${i + 1} / ${all.length}`}
              </p>
              <h2>{pg.title}</h2>
              {pg.lead && !pg.cards && <p class="lead">{pg.lead}</p>}
              {i === 0 && (
                <dl class="frame">
                  <div>
                    <dt>這一輪的目標</dt>
                    <dd>{aiRoundFrame[r.no].goal}</dd>
                  </div>
                  <div>
                    <dt>做完你會有</dt>
                    <dd>{aiRoundFrame[r.no].have}</dd>
                  </div>
                </dl>
              )}
              {pg.guess && (
                <p class="guess">
                  <b>先想一想</b>
                  {pg.guess}
                </p>
              )}
              {pg.type && (
                <p class="type">
                  <b>{pg.type[0]}</b>
                  {pg.type[1]}
                </p>
              )}
              {pg.cards && (
                <ul class:list={["kinds", { two: pg.cards.length === 2 }]}>
                  {pg.cards.map(([head, note]) => (
                    <li>
                      <b>{head}</b>
                      <span>{note}</span>
                    </li>
                  ))}
                </ul>
              )}
              {pg.lead && pg.cards && <p class="lead after">{pg.lead}</p>}
              {pg.compare && (
                <table class="compare">
                  <thead>
                    <tr><th></th><th>HTML 簡報</th><th>PPT</th></tr>
                  </thead>
                  <tbody>
                    {aiCompare.map(([k, h, p]) => (
                      <tr>
                        <th scope="row">{k}</th>
                        <td>{h}</td>
                        <td>{p}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              )}
              {pg.styles && (
                <>
                  <ul class="styles">
                    {aiStyles.map((st) => (
                      <li>
                        <a href={url(`/files/ai/styles/${st.slug}/template.html`)} target="_blank" rel="noopener">
                          <img src={url(`/files/ai/styles/${st.slug}.jpg`)} alt={`${st.name} 的封面`} width="800" height="450" loading="lazy" />
                        </a>
                        <b>{st.zh}</b>
                        <span>{st.fit}</span>
                      </li>
                    ))}
                  </ul>
                  <p class="src">
                    範本取自 <a href={aiStylesSource.url} lang="en">{aiStylesSource.name}</a>（{aiStylesSource.credit}，{aiStylesSource.license} 授權），共 {aiStylesSource.count} 種，這裡挑六種。點縮圖看範本。
                  </p>
                </>
              )}
              {pg.vote && (
                <>
                  <ol class="scenarios">
