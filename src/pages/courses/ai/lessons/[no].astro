---
import Base from "../../../../layouts/Base.astro";
import Art from "../../../../components/Art.astro";
import "../../../../styles/deck.css";
import "../../../../styles/lesson.css";
import { aiCourse, aiLessons, aiModules, aiQuestionOf } from "../../../../data/ai-course";
import { aiSlides } from "../../../../data/ai-lessons";
import { renderScene } from "../../../../lib/scenes.js";
import { url } from "../../../../lib/url";
import fs from "node:fs";

export function getStaticPaths() {
  return aiLessons.map((l) => ({ params: { no: String(l.no) }, props: { lesson: l } }));
}

const { lesson } = Astro.props;
const mod = aiModules.find((m) => m.id === lesson.module)!;
const slides = aiSlides[lesson.no];
// 投影片的 renderer 需要的欄位
const deck = { no: lesson.no, mod: mod.name, modName: mod.label, course: aiCourse.title, slides };
const scenes = slides.map((s, i) => renderScene(s, deck, i, url("/art/"))).join("\n");
const prev = aiLessons[lesson.no - 1];
const next = aiLessons[lesson.no + 1];
const lessonUrl = (n: number) => url(`/courses/ai/lessons/${n}/`);
// 這一堂的上課影片做好了才顯示。檔案放在 public/video/ai/lesson-<堂次>.mp4
const hasVideo = fs.existsSync(`public/video/ai/lesson-${lesson.no}.mp4`);
---

<Base title={`第 ${lesson.no} 堂　${lesson.title}｜${aiCourse.title}`} current="ai" description={lesson.summary}>
  <main class="lesson" data-lesson-no={lesson.no} data-course="ai">
    <div class="wrap">
      <nav class="crumbs" aria-label="所在位置">
        <a href={url("/courses/ai/")}>{aiCourse.title}</a>
        <span aria-hidden="true">／</span>
        <a href={url("/courses/ai/board/")}>課程白板</a>
        <span aria-hidden="true">／</span>
        <span>{mod.name}　{mod.label}</span>
      </nav>
      <header class="lesson-head">
        <span class="no" aria-hidden="true">{lesson.no}</span>
        <div>
          <h1><span class="visually-hidden">第 {lesson.no} 堂　</span>{lesson.title}</h1>
          <p class="why">{lesson.summary}</p>
        </div>
      </header>
    </div>

    {
      hasVideo && (
        <section class="lesson-video" aria-label="這一堂的影片">
          <video
            controls
            preload="metadata"
            playsinline
            poster={url(`/video/ai/lesson-${lesson.no}.jpg`)}
            src={url(`/video/ai/lesson-${lesson.no}.mp4`)}
          >
            你的瀏覽器不能播放這支影片，請看下面的簡報。
          </video>
          <p class="video-note">有字幕，旁白是合成語音。想照自己的速度看，可以用下面的簡報翻頁。</p>
        </section>
      )
    }

    <section class="deck-wrap" aria-label="這一堂的簡報">
      <div class="deck" data-deck tabindex="0" aria-roledescription="簡報">
        <div id="stage" set:html={scenes} />
      </div>
      <div class="deck-bar">
        <button type="button" class="btn btn-quiet" data-deck-prev aria-label="上一張">
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"
            ><path d="M11 4 6 9l5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg
          >
        </button>
        <span class="count" aria-live="polite"><b data-deck-current>1</b> / {slides.length}</span>
        <button type="button" class="btn btn-quiet" data-deck-next aria-label="下一張">
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"
            ><path d="m7 4 5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg
          >
        </button>
        <span class="hint">點簡報後可用鍵盤左右鍵翻頁</span>
        <span class="hint-small">字太小時，把手機橫放或按全螢幕</span>
        <button type="button" class="btn btn-quiet full" data-deck-full>全螢幕</button>
      </div>
      <p class="video-note">
        {hasVideo ? "這是影片用的同一份簡報。" : "這一堂的影片還在製作，目前先看簡報。"}簡報內容是初稿，之後可能調整。
        {lesson.no >= 5 && (
          <>
            {" "}這一堂用的<a href={url("/courses/ai/workshop/paper/")}>示範論文在這裡</a>。
          </>
        )}
      </p>
    </section>

    <div class="wrap below">
      <section class="practice">
        <Art name="pencil-cup" size={92} rotate={-6} class="pinned corner" />
        <div class="practice-head">
          <h2>換你做</h2>
        </div>
        <p class="task">{lesson.task}</p>
      </section>

      {
        aiQuestionOf(lesson.no) && (
          <section class="question">
            <Art name="question-badge" size={92} rotate={8} class="pinned corner" />
            <h2>留給你的問題</h2>
            <p>{aiQuestionOf(lesson.no)}</p>
          </section>
        )
      }

      <section class="finish">
        <label class="done">
          <input type="checkbox" data-done-toggle />
          <span class="box" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 20 20"
              ><path d="M4 10.5 8.2 14.5 16 6" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path></svg
            >
          </span>
          <span>
            <strong>我學完這一堂了</strong>
            <small>只記在這台裝置的瀏覽器裡，隨時可以取消。</small>
          </span>
          <Art name="done" size={96} rotate={-9} class="done-sticker" />
        </label>
        <nav class="pager" aria-label="前後堂">
          {
            prev ? (
              <a href={lessonUrl(prev.no)} rel="prev">
                <small>上一堂　第 {prev.no} 堂</small>
                {prev.title}
              </a>
            ) : (
              <span />
            )
          }
          {
            next ? (
              <a href={lessonUrl(next.no)} rel="next" class="next">
                <small>下一堂　第 {next.no} 堂</small>
                {next.title}
              </a>
            ) : (
              <a href={url("/courses/ai/board/")} class="next">
                <small>最後一堂了</small>
                回到課程白板
              </a>
            )
          }
        </nav>
      </section>
    </div>
  </main>
</Base>

<script>
  import "../../../../scripts/lesson";
</script>
