---
import Base from "../../../../layouts/Base.astro";
import RoleSwitch from "../../../../components/RoleSwitch.astro";
import "../../../../styles/deck.css";
import { lessons } from "../../../../data/course";
import { renderScene } from "../../../../lib/scenes.js";
import { url } from "../../../../lib/url";

export function getStaticPaths() {
  return lessons.map((l) => ({ params: { no: String(l.no) }, props: { lesson: l } }));
}

const { lesson } = Astro.props;
const prev = lessons[lesson.no - 1];
const next = lessons[lesson.no + 1];
const scenes = lesson.slides.map((s, i) => renderScene(s, lesson, i)).join("\n");
const lessonUrl = (n: number) => url(`/courses/obsidian/lessons/${n}/`);
---

<Base title={`第 ${lesson.no} 堂　${lesson.title}`} current="course" description={lesson.why ?? lesson.title}>
  <main class="lesson" data-lesson-no={lesson.no}>
    <div class="wrap">
      <nav class="crumbs" aria-label="所在位置">
        <a href={url("/courses/obsidian/")}>Obsidian 研究筆記課</a>
        <span aria-hidden="true">／</span>
        <a href={url("/courses/obsidian/board/")}>學習白板</a>
        <span aria-hidden="true">／</span>
        <span>{lesson.mod}　{lesson.modName}</span>
      </nav>
      <header class="lesson-head">
        <span class="no" aria-hidden="true">{lesson.no}</span>
        <div>
          <h1><span class="visually-hidden">第 {lesson.no} 堂　</span>{lesson.title}</h1>
          {lesson.why && <p class="why">{lesson.why}</p>}
        </div>
      </header>
    </div>

    <section class="deck-wrap" aria-label="這一堂的簡報">
      <div class="deck" data-deck tabindex="0" aria-roledescription="簡報">
        <div id="stage" set:html={scenes} />
      </div>
      <div class="deck-bar">
        <button type="button" class="btn btn-quiet" data-deck-prev aria-label="上一張">
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"
            ><path d="M11 4 6 9l5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg
          >
        </button>
        <span class="count" aria-live="polite"><b data-deck-current>1</b> / {lesson.slides.length}</span>
        <button type="button" class="btn btn-quiet" data-deck-next aria-label="下一張">
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"
            ><path d="m7 4 5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg
          >
        </button>
        <span class="hint">點簡報後可用鍵盤左右鍵翻頁</span>
        <span class="hint-small">字太小時，把手機橫放或按全螢幕</span>
        <button type="button" class="btn btn-quiet full" data-deck-full>全螢幕</button>
      </div>
      <p class="video-note">這一堂的影片還在錄製，目前先看簡報。簡報裡的介面畫面是示意圖。</p>
    </section>

    <div class="wrap below">
      {
        lesson.practice && (
          <section class="practice">
            <div class="practice-head">
              <h2>{lesson.practice.title.replace(/^換你做：?/, "換你做：") || "換你做"}</h2>
              <RoleSwitch />
            </div>
            {(["a", "b"] as const).map((r) => (
              <div class="practice-card" data-role-show={r}>
                <h3>
                  <span class="tag">{lesson.practice![r].tag}</span>
                  {lesson.practice![r].head}
                </h3>
                <ol>
                  {lesson.practice![r].lines.map((line) => (
                    <li>{line}</li>
                  ))}
                </ol>
              </div>
            ))}
          </section>
        )
      }

      {
        lesson.question && (
          <section class="question">
            <h2>留給你的問題</h2>
            <p>{lesson.question}</p>
          </section>
        )
      }

      <section class="finish">
        <label class="done">
          <input type="checkbox" data-done-toggle />
          <span class="box" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 20 20"
              ><path d="M4 10.5 8.2 14.5 16 6" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path></svg
            >
          </span>
          <span>
            <strong>我學完這一堂了</strong>
            <small>只記在這台裝置的瀏覽器裡，隨時可以取消。</small>
          </span>
        </label>
        <nav class="pager" aria-label="前後堂">
          {
            prev ? (
              <a href={lessonUrl(prev.no)} rel="prev">
                <small>上一堂　第 {prev.no} 堂</small>
                {prev.title}
              </a>
            ) : (
              <span />
            )
          }
          {
            next ? (
              <a href={lessonUrl(next.no)} rel="next" class="next">
                <small>下一堂　第 {next.no} 堂</small>
                {next.title}
              </a>
            ) : (
              <a href={url("/courses/obsidian/board/")} class="next">
                <small>最後一堂了</small>
                回到學習白板
              </a>
            )
          }
        </nav>
      </section>
    </div>
  </main>
</Base>

<script>
  import { getDone, setDone } from "../../../../scripts/progress";

  // 簡報：1920×1080 的舞台等比縮進容器
  const deck = document.querySelector<HTMLElement>("[data-deck]")!;
  const stage = deck.querySelector<HTMLElement>("#stage")!;
  const scenes = [...stage.querySelectorAll<HTMLElement>(".scene")];
  const current = document.querySelector<HTMLElement>("[data-deck-current]")!;
  const prevBtn = document.querySelector<HTMLButtonElement>("[data-deck-prev]")!;
  const nextBtn = document.querySelector<HTMLButtonElement>("[data-deck-next]")!;
  let index = 0;

  const fit = () => {
    const k = Math.min(deck.clientWidth / 1920, deck.clientHeight / 1080);
    stage.style.transform = `scale(${k})`;
    stage.style.left = `${(deck.clientWidth - 1920 * k) / 2}px`;
    stage.style.top = `${(deck.clientHeight - 1080 * k) / 2}px`;
  };
  const show = (i: number) => {
    index = Math.max(0, Math.min(scenes.length - 1, i));
    scenes.forEach((s, j) => s.classList.toggle("active", j === index));
    current.textContent = String(index + 1);
    prevBtn.disabled = index === 0;
    nextBtn.disabled = index === scenes.length - 1;
    history.replaceState(null, "", index ? `#s${index + 1}` : location.pathname);
  };
  new ResizeObserver(fit).observe(deck);
  prevBtn.addEventListener("click", () => show(index - 1));
  nextBtn.addEventListener("click", () => show(index + 1));
  deck.addEventListener("keydown", (e) => {
    if (e.key === "ArrowRight" || e.key === "PageDown") (e.preventDefault(), show(index + 1));
    else if (e.key === "ArrowLeft" || e.key === "PageUp") (e.preventDefault(), show(index - 1));
    else if (e.key === "Home") (e.preventDefault(), show(0));
    else if (e.key === "End") (e.preventDefault(), show(scenes.length - 1));
  });
  deck.addEventListener("click", (e) => {
    const r = deck.getBoundingClientRect();
    show(index + (e.clientX - r.left < r.width / 3 ? -1 : 1));
  });
  const full = document.querySelector<HTMLButtonElement>("[data-deck-full]")!;
  if (!document.fullscreenEnabled) full.hidden = true;
  full.addEventListener("click", () => {
    if (document.fullscreenElement) document.exitFullscreen();
    else deck.requestFullscreen().then(() => deck.focus()).catch(() => {});
  });
  const m = /^#s(\d+)$/.exec(location.hash);
  fit();
  show(m ? Number(m[1]) - 1 : 0);

  // 進度
  const no = Number(document.querySelector<HTMLElement>("[data-lesson-no]")!.dataset.lessonNo);
  const toggle = document.querySelector<HTMLInputElement>("[data-done-toggle]")!;
  toggle.checked = getDone().has(no);
  toggle.addEventListener("change", () => setDone(no, toggle.checked));
</script>

<style>
  .lesson {
    padding-bottom: clamp(3rem, 8vw, 6rem);
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.6rem;
    padding-top: 1rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .crumbs a {
    color: var(--muted);
  }
  .lesson-head {
    display: flex;
    align-items: flex-start;
    gap: clamp(1rem, 3vw, 2rem);
    padding-block: clamp(1.5rem, 4vw, 3rem);
  }
  .lesson-head .no {
    flex: none;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(3.5rem, 10vw, 6rem);
    line-height: 0.9;
    color: var(--violet);
  }
  .lesson-head h1 {
    font-size: clamp(1.9rem, 5vw, 3.5rem);
  }
  .why {
    margin-top: 0.6rem;
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    color: var(--muted);
  }

  .deck-wrap {
    width: min(100% - 2 * var(--gutter), 80rem);
    margin-inline: auto;
  }
  .deck {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 14px;
    background: var(--ink);
    box-shadow: var(--shadow);
    cursor: pointer;
  }
  .deck:fullscreen {
    border-radius: 0;
    aspect-ratio: auto;
  }
  .deck-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.9rem;
  }
  .deck-bar .btn {
    min-height: 2.75rem;
    padding-inline: 0.85rem;
    background: var(--surface);
  }
  .deck-bar .btn:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .count {
    min-width: 4.5em;
    text-align: center;
    color: var(--muted);
  }
  .count b {
    color: var(--ink);
  }
  .hint {
    color: var(--muted);
    font-size: 0.875rem;
  }
  .deck-bar .full {
    margin-left: auto;
  }
  .video-note {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .below {
    max-width: 56rem;
  }
  .below > section {
    margin-top: clamp(3rem, 7vw, 5rem);
  }
  .below h2 {
    font-size: clamp(1.4rem, 3vw, 2rem);
  }
  .practice-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .practice-card {
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: 18px;
    background: var(--role-soft);
  }
  .practice-card h3 {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.25rem;
  }
  .tag {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--role);
    color: #fff;
    font-size: 1rem;
  }
  .practice-card ol {
    margin-top: 1rem;
    counter-reset: p;
  }
  .practice-card li {
    counter-increment: p;
    display: grid;
    grid-template-columns: 1.75rem 1fr;
    padding: 0.5rem 0;
    font-size: 1.0625rem;
  }
  .practice-card li::before {
    content: counter(p);
    font-weight: 700;
    color: var(--role);
  }
  .question p {
    margin-top: 0.75rem;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(1.25rem, 2.8vw, 1.75rem);
    line-height: 1.5;
    max-width: 26em;
  }

  .done {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    border: 2px solid var(--rule);
    border-radius: 14px;
    background: var(--surface);
    cursor: pointer;
    transition:
      border-color 0.2s var(--ease-out),
      background-color 0.2s var(--ease-out);
  }
  .done:hover {
    border-color: var(--ink);
  }
  .done input {
    position: absolute;
    opacity: 0;
  }
  .done .box {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 2px solid var(--muted);
    border-radius: 8px;
    color: transparent;
    transition:
      background-color 0.2s var(--ease-out),
      border-color 0.2s var(--ease-out);
  }
  .done input:checked + .box {
    background: var(--teal);
    border-color: var(--teal);
    color: #fff;
  }
  .done input:focus-visible + .box {
    outline: 2px solid var(--violet);
    outline-offset: 3px;
  }
  .done:has(input:checked) {
    border-color: var(--teal);
    background: var(--teal-soft);
  }
  .done strong {
    display: block;
    line-height: 1.4;
  }
  .done small {
    color: var(--muted);
    font-size: 0.875rem;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .pager a {
    padding: 1rem 0;
    border-top: 2px solid var(--ink);
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
  }
  .pager a:hover {
    color: var(--violet);
    border-top-color: var(--violet);
  }
  .pager .next {
    text-align: right;
  }
  .pager small {
    display: block;
    font-weight: 400;
    color: var(--muted);
  }
  .hint-small {
    display: none;
    color: var(--muted);
    font-size: 0.8125rem;
    line-height: 1.4;
  }
  @media (max-width: 620px) {
    .hint {
      display: none;
    }
    .hint-small {
      display: block;
    }
    .deck-bar .full {
      background: var(--violet);
      border-color: var(--violet);
      color: #fff;
    }
  }

  /* ───── 手繪紙張風的調整 ───── */
  .crumbs,
  .crumbs a,
  .why,
  .video-note,
  .count,
  .hint,
  .hint-small {
    color: var(--muted);
  }
  .lesson-head .no {
    color: var(--blue);
  }
  /* 簡報像一張貼在桌上的照片 */
  .lesson {
    overflow-x: clip;
  }
  .deck-wrap {
    position: relative;
  }
  .deck {
    border-radius: 2px;
    border: 10px solid var(--surface);
    box-shadow: var(--shadow);
  }
  .deck:fullscreen {
    border: 0;
  }
  .deck-wrap::before,
  .deck-wrap::after {
    content: "";
    position: absolute;
    top: -12px;
    width: 6.5rem;
    height: 26px;
    background: rgb(246 244 236 / 0.62);
    border-inline: 1px dashed rgb(140 135 120 / 0.45);
    z-index: 1;
  }
  .deck-wrap::before {
    left: -1.5rem;
    rotate: -32deg;
  }
  .deck-wrap::after {
    right: -1.5rem;
    rotate: 30deg;
  }
  .below > section {
    position: relative;
    margin-top: clamp(2rem, 5vw, 3rem);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: var(--grain), var(--surface);
    border-radius: 2px;
    box-shadow: var(--shadow);
  }
  .below > section:nth-child(odd) {
    rotate: -0.3deg;
  }
  .below > section:nth-child(even) {
    rotate: 0.35deg;
  }
  .practice-card {
    border-radius: 2px;
  }
  .question p {
    font-size: clamp(1.4rem, 3vw, 1.9rem);
  }
  .done {
    border: 2px solid var(--ink);
    border-radius: var(--wob-b);
  }
  .done:hover {
    background: var(--paper);
  }
  .done .box {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--wob-a);
    border-color: var(--ink);
  }
  .done input:checked + .box {
    background: var(--surface);
    border-color: var(--ink);
    color: var(--green);
  }
  .done:has(input:checked) {
    border-color: var(--green);
    background: #dfe9d8;
  }
  .pager a:hover {
    color: var(--blue);
    border-top-color: var(--marker);
  }
  @media (max-width: 620px) {
    .deck-bar .full {
      background: var(--marker);
      border-color: var(--ink);
      color: var(--ink);
    }
    .deck {
      border-width: 5px;
    }
  }
</style>
