---
import Base from "../../../layouts/Base.astro";
import RoleSwitch from "../../../components/RoleSwitch.astro";
import { obsidianCourse } from "../../../data/site";
import {
  lessons,
  modules,
  lessonsOf,
  boardNodes,
  boardEdges,
  boardRegions,
  tools,
  liveFlow,
  workshopFlow,
  BOARD_W,
  BOARD_H,
  CARD_W,
  CARD_H,
} from "../../../data/course";
import { url } from "../../../lib/url";

const lessonUrl = (n: number) => url(`/courses/obsidian/lessons/${n}/`);
const nodeName = (id: string) => {
  const n = boardNodes.find((x) => x.id === id)!;
  return n.kind === "lesson" ? `第 ${n.no} 堂　${n.title}` : n.title;
};
const linksOf = (id: string) =>
  boardEdges
    .filter((e) => e.label && (e.from === id || e.to === id))
    .map((e) => ({ label: e.label!, other: e.from === id ? e.to : e.from, dir: e.from === id ? "之後" : "之前" }));
const check = `<svg width="16" height="16" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10.5 8.2 14.5 16 6" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---

<Base bare title="學習白板｜Obsidian 研究筆記課" description="Obsidian 研究筆記課的學習歷程白板：17 堂課與它們之間的呼應。">
  <div class="app" data-board data-view="board">
    <header class="bar">
      <a class="back" href={url("/courses/obsidian/")} aria-label="回到課程介紹">
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"
          ><path d="M11 4 6 9l5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg
        >
        <span>Obsidian 研究筆記課</span>
      </a>
      <h1>學習白板</h1>
      <p class="progress" aria-live="polite">
        <span class="meter" aria-hidden="true"><i data-progress-bar></i></span>
        <span data-progress-text>學完 0 / {lessons.length} 堂</span>
      </p>
      <RoleSwitch />
      <div class="view-switch" role="group" aria-label="檢視方式">
        <button type="button" data-view-btn="board" aria-pressed="true">白板</button>
        <button type="button" data-view-btn="list" aria-pressed="false">清單</button>
      </div>
    </header>

    <div class="canvas" data-canvas tabindex="0" aria-label="課程白板。拖曳可以移動畫面，方向鍵也可以；加號與減號縮放。">
      <div class="world" data-world style={`width:${BOARD_W}px;height:${BOARD_H}px`}>
        {
          boardRegions.map((r) => (
            <div class="region" style={`left:${r.x}px;top:${r.y}px;width:${r.w}px;height:${r.h}px`}>
              <span>{r.label}</span>
            </div>
          ))
        }
        <svg class="edges" width={BOARD_W} height={BOARD_H} aria-hidden="true">
          <defs>
            <marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M1 1 9 5 1 9" fill="none" stroke="context-stroke" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
            </marker>
          </defs>
          {
            boardEdges.map((e, i) => (
              <path data-edge={i} data-from={e.from} data-to={e.to} class={e.label ? "callback" : "seq"} marker-end="url(#arrow)" />
            ))
          }
        </svg>
        {
          boardEdges.map(
            (e, i) =>
              e.label && (
                <span class="edge-label" data-edge-label={i} data-at={e.labelAt ?? 0.5} data-from={e.from} data-to={e.to}>
                  {e.label}
                </span>
              ),
          )
        }
        {
          boardNodes.map((n) => (
            <button
              type="button"
              class:list={["card", n.kind]}
              data-node={n.id}
              data-no={n.no}
              data-x={n.x}
              data-y={n.y}
              style={`left:${n.x}px;top:${n.y}px;width:${CARD_W}px;height:${CARD_H}px`}
              aria-controls="inspector"
            >
              {n.kind === "lesson" ? (
                <>
                  <span class="no">{n.no}</span>
                  <span class="title">{n.title}</span>
                  <span class="badge" set:html={check} />
                  <span class="visually-hidden" data-state-text />
                </>
              ) : (
                <>
                  <span class="title">{n.title}</span>
                  <span class="sub">{n.sub}</span>
                </>
              )}
            </button>
          ))
        }
      </div>

      <div class="tools" role="toolbar" aria-label="白板工具">
        <button type="button" data-tool="out" aria-label="縮小">
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M4 9h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
        </button>
        <output data-zoom aria-label="目前縮放">100%</output>
        <button type="button" data-tool="in" aria-label="放大">
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M4 9h10M9 4v10" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
        </button>
        <button type="button" data-tool="fit">看全部</button>
        <button type="button" data-tool="reset">排回原樣</button>
      </div>
    </div>

    <aside class="inspector" id="inspector" data-inspector aria-label="卡片內容">
      <button type="button" class="close" data-inspector-close aria-label="關閉">
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="m4 4 10 10M14 4 4 14" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
      </button>

      <section data-panel="intro">
        <h2>這張白板怎麼看</h2>
        <ul class="legend">
          <li><svg width="44" height="12" aria-hidden="true"><path d="M2 6h40" class="seq"></path></svg>實線是上課順序</li>
          <li><svg width="44" height="12" aria-hidden="true"><path d="M2 6h40" class="callback"></path></svg>虛線是前後呼應的地方</li>
        </ul>
        <p>點一張卡片看那一堂在教什麼。卡片可以拖到你順手的位置，位置會記在這台裝置上。</p>
        <a class="btn btn-primary" data-next-link href={lessonUrl(0)}>開始第 0 堂</a>
      </section>

      {
        lessons.map((l) => (
          <section data-panel={`l${l.no}`} hidden>
            <h2>
              <span class="no">{l.no}</span>
              {l.title}
            </h2>
            {l.why && <p class="why">{l.why}</p>}
            <p class="where">
              {l.mod}　{l.modName}
            </p>
            {l.practice &&
              (["a", "b"] as const).map((r) => (
                <div class="practice" data-role-show={r}>
                  <h3>
                    <span class="tag">{l.practice![r].tag}</span>換你做
                  </h3>
                  <ol>
                    {l.practice![r].lines.map((line) => (
                      <li>{line}</li>
                    ))}
                  </ol>
                </div>
              ))}
            {linksOf(`l${l.no}`).length > 0 && (
              <div class="links">
                <h3>和其他堂的呼應</h3>
                <ul>
                  {linksOf(`l${l.no}`).map((k) => (
                    <li>
                      <button type="button" data-goto={k.other}>
                        {nodeName(k.other)}
                      </button>
                      <span>{k.label}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            <div class="panel-actions">
              <a class="btn btn-primary" href={lessonUrl(l.no)}>
                進入第 {l.no} 堂
              </a>
              <label class="done">
                <input type="checkbox" data-done={l.no} />
                <span class="box" set:html={check} />
                學完了
              </label>
            </div>
          </section>
        ))
      }

      {
        tools.map((t) => (
          <section data-panel={t.id} hidden>
            <h2>{t.name}</h2>
            <p class="where">選修　{t.kind}</p>
            <p class="why">{t.summary}</p>
            <div class="links">
              <h3>學完這幾堂再來</h3>
              <ul>
                {t.after.map((n) => (
                  <li>
                    <button type="button" data-goto={`l${n}`}>
                      {nodeName(`l${n}`)}
                    </button>
                  </li>
                ))}
              </ul>
            </div>
            <p class="pending">{t.note}</p>
            <div class="panel-actions">
              <a class="btn btn-primary" href={url(`/courses/obsidian/#${t.id}`)}>看怎麼開始</a>
              <a class="btn btn-quiet" href={t.url} target="_blank" rel="noopener">GitHub 專案頁</a>
            </div>
          </section>
        ))
      }

      <section data-panel="live" hidden>
        <h2>線上直播</h2>
        <p class="why">階段一　{obsidianCourse.liveDate || "日期即將公布"}</p>
        <ol class="flow">
          {liveFlow.map(([what, min]) => <li><span>{what}</span><span>{min} 分</span></li>)}
        </ol>
        {
          obsidianCourse.meetUrl ? (
            <a class="btn btn-primary" href={obsidianCourse.meetUrl} target="_blank" rel="noopener">加入 Google Meet 直播</a>
          ) : (
            <p class="pending">Google Meet 連結即將公布。</p>
          )
        }
      </section>
      <section data-panel="workshop" hidden>
        <h2>實體工作坊</h2>
        <p class="why">階段三　{obsidianCourse.workshopDate || "日期即將公布"}</p>
        <ol class="flow">
          {workshopFlow.map(([what, min]) => <li><span>{what}</span><span>{min} 分</span></li>)}
        </ol>
        <p class="pending">請先看完第 0 到 12 堂，並帶三到五篇自己的文獻。</p>
      </section>
    </aside>

    <main class="list" data-list>
      <div class="list-inner">
        {
          modules.map((m) => (
            <section>
              <h2>
                {m.name}　{m.label}
              </h2>
              <ol>
                {lessonsOf(m.id).map((l) => (
                  <li data-list-item={l.no}>
                    <label class="done">
                      <input type="checkbox" data-done={l.no} aria-label={`第 ${l.no} 堂學完了`} />
                      <span class="box" set:html={check} />
                    </label>
                    <a href={lessonUrl(l.no)}>
                      <span class="no">{l.no}</span>
                      <span class="title">{l.title}</span>
                      <span class="why">{l.why}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </section>
          ))
        }
      </div>
    </main>
  </div>
  <noscript>
    <p style="padding:1rem">白板需要 JavaScript。你也可以直接從<a href={url("/courses/obsidian/#lessons")}>課程目錄</a>進入每一堂。</p>
  </noscript>
</Base>

<script>
  import "../../../scripts/board";
</script>

<style is:global>
  html:has(.app),
  html:has(.app) body {
    height: 100%;
    overflow: hidden;
  }
  .app {
    --panel: 21.5rem;
    display: grid;
    grid-template: auto minmax(0, 1fr) / minmax(0, 1fr) var(--panel);
    height: 100dvh;
  }

  /* 頂列 */
  .bar {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 0.75rem 1.25rem;
    padding: 0.6rem var(--gutter);
    background: var(--surface);
    border-bottom: 1px solid var(--rule);
    z-index: 3;
  }
  .bar .back {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.75rem;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9375rem;
  }
  .bar .back:hover {
    color: var(--ink);
  }
  .bar h1 {
    font-size: 1.25rem;
    letter-spacing: 0;
  }
  .bar .progress {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-right: auto;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .meter {
    width: 6rem;
    height: 6px;
    border-radius: 3px;
    background: var(--rule);
    overflow: hidden;
  }
  .meter i {
    display: block;
    height: 100%;
    width: 0;
    background: var(--teal);
    transition: width 0.5s var(--ease-out);
  }
  .bar .role-switch,
  .view-switch {
    display: inline-flex;
    padding: 3px;
    border-radius: 10px;
    background: var(--paper);
    border: 1px solid var(--rule);
  }
  .bar .role-switch button,
  .view-switch button {
    min-height: 2.25rem;
    padding: 0.15rem 0.9rem;
    border: 0;
    border-radius: 7px;
    background: transparent;
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--muted);
    cursor: pointer;
  }
  .bar .role-switch button[aria-pressed="true"] {
    background: var(--role);
    color: #fff;
  }
  .view-switch button[aria-pressed="true"] {
    background: var(--ink);
    color: #fff;
  }

  /* 畫布 */
  .canvas {
    position: relative;
    overflow: hidden;
    background-color: var(--paper);
    background-image: radial-gradient(circle at 1px 1px, #c9c5da 1.3px, transparent 0);
    touch-action: none;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }
  .canvas.is-panning {
    cursor: grabbing;
  }
  .canvas:focus-visible {
    outline-offset: -3px;
  }
  .world {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: 0 0;
    will-change: transform;
  }
  .region {
    position: absolute;
    border: 2px dashed var(--rule);
    border-radius: 26px;
    background: rgb(255 255 255 / 0.45);
  }
  .region span {
    position: absolute;
    left: 28px;
    top: 16px;
    font-weight: 700;
    color: var(--muted);
  }
  .edges {
    position: absolute;
    left: 0;
    top: 0;
    overflow: visible;
    pointer-events: none;
  }
  .edges path,
  .legend path {
    fill: none;
    stroke-linecap: round;
  }
  .edges .seq,
  .legend .seq {
    stroke: #a39fb8;
    stroke-width: 2.5;
  }
  .edges .callback,
  .legend .callback {
    stroke: var(--violet);
    stroke-width: 2.5;
    stroke-dasharray: 3 8;
  }
  .edges path {
    transition:
      opacity 0.25s var(--ease-out),
      stroke-width 0.25s var(--ease-out);
  }
  .edge-label {
    position: absolute;
    transform: translate(-50%, -50%);
    max-width: 15em;
    padding: 0.2rem 0.7rem;
    border-radius: 8px;
    background: var(--violet-soft);
    color: var(--violet-deep);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.45;
    text-align: center;
    pointer-events: none;
    transition: opacity 0.25s var(--ease-out);
  }
  .has-selection .edges path:not(.is-related),
  .has-selection .edge-label:not(.is-related) {
    opacity: 0.22;
  }
  .edges path.is-related {
    stroke-width: 4;
  }

  /* 卡片 */
  .card {
    position: absolute;
    display: grid;
    grid-template-columns: auto 1fr;
    align-content: center;
    gap: 0 0.9rem;
    padding: 0 1.1rem;
    border: 2px solid transparent;
    border-radius: 16px;
    background: var(--surface);
    box-shadow: var(--shadow);
    text-align: left;
    cursor: pointer;
    touch-action: none;
    transition:
      box-shadow 0.2s var(--ease-out),
      border-color 0.2s var(--ease-out),
      background-color 0.3s var(--ease-out);
  }
  .card:hover {
    border-color: var(--rule);
    box-shadow:
      0 2px 4px rgb(30 26 46 / 0.08),
      0 14px 34px rgb(30 26 46 / 0.14);
  }
  .card.is-dragging {
    cursor: grabbing;
    z-index: 2;
    box-shadow:
      0 4px 8px rgb(30 26 46 / 0.1),
      0 22px 48px rgb(30 26 46 / 0.2);
  }
  .card .no {
    font-family: var(--serif);
    font-weight: 900;
    font-size: 2.75rem;
    line-height: 1;
    color: var(--violet);
    min-width: 1.1em;
  }
  .card .title {
    font-weight: 700;
    line-height: 1.35;
    font-size: 1.1875rem;
  }
  .card .badge {
    position: absolute;
    right: -9px;
    top: -9px;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--teal);
    color: #fff;
    transform: scale(0);
    transition: transform 0.35s var(--ease-out);
  }
  .card.is-done .badge {
    transform: scale(1);
  }
  .card.is-done {
    background: #fbfbfd;
  }
  .card.is-done .no {
    color: var(--muted);
  }
  .card.is-next {
    background: var(--violet);
    color: #fff;
  }
  .card.is-next .no {
    color: #fff;
  }
  .card.is-next::after {
    content: "接著學這一堂";
    position: absolute;
    left: 14px;
    top: -17px;
    padding: 0.05rem 0.65rem;
    border-radius: 7px;
    background: var(--ink);
    color: #fff;
    font-size: 0.9375rem;
    font-weight: 700;
  }
  .card.is-selected {
    border-color: var(--ink);
  }
  .card.is-next.is-selected {
    border-color: var(--ink);
  }
  .card.event {
    grid-template-columns: 1fr;
    background: transparent;
    box-shadow: none;
    border: 2px dashed var(--ink);
  }
  .card.event:hover {
    background: var(--surface);
  }
  .card.event .sub {
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .card.tool {
    grid-template-columns: 1fr;
    background: var(--paper);
    box-shadow: none;
    border: 2px solid var(--rule);
  }
  .card.tool .sub {
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .card.tool:hover,
  .card.tool.is-selected {
    background: var(--surface);
    border-color: var(--ink);
  }
  .card.event.is-selected {
    border-style: solid;
    background: var(--surface);
  }

  /* 工具列 */
  .tools {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 4px;
    border-radius: 12px;
    background: var(--surface);
    box-shadow: var(--shadow);
    cursor: default;
  }
  .tools button {
    display: grid;
    place-items: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0 0.75rem;
    border: 0;
    border-radius: 8px;
    background: transparent;
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
  }
  .tools button:hover {
    background: var(--paper);
  }
  .tools output {
    min-width: 3.25em;
    text-align: center;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  /* 右側內容 */
  .inspector {
    position: relative;
    overflow-y: auto;
    padding: 1.5rem 1.5rem 2rem;
    background: var(--surface);
    border-left: 1px solid var(--rule);
    scrollbar-width: thin;
  }
  .inspector .close {
    display: none;
  }
  .inspector h2 {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    font-size: 1.5rem;
    line-height: 1.35;
  }
  .inspector h2 .no {
    color: var(--violet);
    font-size: 2.25rem;
    line-height: 1;
  }
  .inspector h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
  }
  .inspector .where {
    margin-top: 0.35rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .inspector .why {
    margin-top: 0.6rem;
    color: var(--muted);
  }
  .inspector [data-panel="intro"] p {
    margin: 1rem 0 1.5rem;
    color: var(--muted);
  }
  .legend {
    margin-top: 1.25rem;
    display: grid;
    gap: 0.4rem;
  }
  .legend li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .inspector .practice {
    margin-top: 1.5rem;
    padding: 1rem 1.1rem;
    border-radius: 14px;
    background: var(--role-soft);
  }
  .inspector .tag {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--role);
    color: #fff;
    font-size: 0.875rem;
  }
  .inspector .practice ol {
    margin-top: 0.6rem;
    padding-left: 1.3em;
    list-style: decimal;
    font-size: 0.9875rem;
  }
  .inspector .practice li {
    padding: 0.15rem 0;
  }
  .inspector .links {
    margin-top: 1.5rem;
  }
  .inspector .links li {
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .inspector .links button {
    display: block;
    padding: 0;
    border: 0;
    background: none;
    color: var(--violet);
    font-weight: 700;
    text-align: left;
    cursor: pointer;
  }
  .inspector .links button:hover {
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }
  .inspector .links span {
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .panel-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 1.75rem;
  }
  .app .done {
