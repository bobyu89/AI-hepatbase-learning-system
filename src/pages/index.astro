---
import Base from "../layouts/Base.astro";
import CourseMap from "../components/CourseMap.astro";
import { site } from "../data/site";
import { lessons, stages } from "../data/course";
import { url } from "../lib/url";
---

<Base current="home" description="把一門課攤開成一張白板：每一堂是一張卡片，前後呼應的地方畫成連線。">
  <main>
    <section class="hero">
      <div class="hero-copy wrap">
        <h1>把一門課<br />攤開成<span class="scribble">一張白板</span></h1>
        <div class="hero-side">
          <p class="lede">
            每一堂是一張卡片，前後呼應的地方畫成連線。學到哪裡、下一堂是什麼，一眼就看得到。進度記在你的瀏覽器裡，不用登入，也不評分。
          </p>
          <div class="actions">
            <a class="btn btn-primary" href={url("/courses/obsidian/board/")}>
              打開學習白板
              <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"
                ><path d="M3 9h11M10 4.5 14.5 9 10 13.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg
              >
            </a>
            <a class="btn btn-quiet" href={url("/courses/obsidian/")}>先看課程介紹</a>
          </div>
        </div>
      </div>
      <div class="hero-map">
        <CourseMap />
      </div>
    </section>

    <section class="section course" id="courses">
      <div class="wrap">
        <h2>現在開的課</h2>
        <article class="feature">
          <div class="feature-head">
            <h3><a href={url("/courses/obsidian/")}>Obsidian 研究筆記課</a></h3>
            <p class="quote"><span class="hi">「我明明讀過，為什麼找不到？」</span></p>
            <p>
              給護理領域的研究生與老師。從安裝開始，學會讓筆記互相連結、加上欄位、排成表格與看板，最後把筆記組成報告裡的一段文字。
            </p>
          </div>
          <ol class="stages">
            {
              stages.map((s) => (
                <li>
                  <strong>{s.name}</strong>
                  <span>{s.length}</span>
                  <em>{s.job}</em>
                </li>
              ))
            }
          </ol>
          <p class="facts">
            {lessons.length} 堂預錄課，每堂 10 到 15 分鐘。研究生與老師看同一支影片，做不同的練習。
          </p>
          <div class="actions">
            <a class="btn btn-primary" href={url("/courses/obsidian/board/")}>打開學習白板</a>
            <a class="btn btn-quiet" href={url("/courses/obsidian/")}>課程介紹</a>
          </div>
        </article>
        <p class="more">目前只有這一門課。之後開的課會出現在這裡，每一門都有自己的白板。</p>
      </div>
    </section>

    <section class="section how">
      <div class="wrap">
        <h2>在這裡怎麼學</h2>
        <dl>
          <div>
            <dt>先看全貌，再挑一張卡片</dt>
            <dd>
              課程攤在白板上，上課順序是實線，前後呼應的地方是虛線。你可以拖動卡片、放大縮小，排成自己看得順的樣子。
            </dd>
          </div>
          <div>
            <dt>進度是給你自己看的</dt>
            <dd>
              學完一堂，在卡片上打勾。紀錄只存在你這台裝置的瀏覽器，沒有人看得到，也不算成績。換一台裝置會從頭開始。
            </dd>
          </div>
          <div>
            <dt>兩種身分，兩張練習卡</dt>
            <dd>
              選一次身分，之後每一堂會先顯示你的那張卡：<span class="a">研究生做 A 卡</span>，<span class="b">老師做 B 卡</span
              >。隨時可以換。
            </dd>
          </div>
        </dl>
      </div>
    </section>
  </main>
</Base>

<style>
  .hero {
    overflow: hidden;
    padding-top: clamp(2rem, 5vw, 4rem);
  }
  .hero-copy {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 2rem clamp(2rem, 6vw, 5rem);
    align-items: end;
  }
  .hero h1 {
    font-size: clamp(2.6rem, 6.6vw, 5.5rem);
    line-height: 1.2;
    white-space: nowrap;
  }
  .hero-side {
    padding-bottom: 0.6rem;
  }
  .hero .lede {
    color: var(--ink);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.75rem;
  }
  .hero-map {
    margin: clamp(2.5rem, 6vw, 4.5rem) auto 0;
    width: min(100% - 2 * var(--gutter), 72rem);
    padding-bottom: clamp(1.5rem, 4vw, 3rem);
  }
  .hero-map :global(figcaption) {
    position: absolute;
    left: 0;
    top: -0.25rem;
    margin: 0;
    transform: translateY(-100%);
  }

  /* 現在開的課：一張索引卡 */
  .feature {
    position: relative;
    margin-top: 1.75rem;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 1.5rem clamp(2rem, 6vw, 5rem);
    padding: clamp(2.6rem, 5vw, 3.6rem) clamp(1.25rem, 4vw, 2.75rem) clamp(1.5rem, 4vw, 2.5rem);
    background:
      linear-gradient(var(--rule-red), var(--rule-red)) 0 2rem / 100% 2px no-repeat,
      var(--card);
    border-radius: 2px;
    box-shadow: var(--shadow);
    rotate: 0.5deg;
  }
  .feature h3 {
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    line-height: 1.3;
  }
  .feature h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  .feature h3 a:hover {
    color: var(--blue);
  }
  .quote {
    margin: 0.75rem 0 1rem;
    font-size: 1.35rem;
  }
  .feature-head p:last-child {
    max-width: var(--measure);
  }
  .stages {
    align-self: start;
    display: grid;
    gap: 0;
  }
  .stages li {
    display: grid;
    grid-template-columns: 6.5em 1fr auto;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.6rem 0;
    border-bottom: 1.5px solid var(--rule);
  }
  .stages li:first-child {
    border-top: 1.5px solid var(--rule);
  }
  .stages span,
  .stages em {
    font-style: normal;
    color: var(--muted);
  }
  .stages em {
    color: var(--blue);
  }
  .facts {
    grid-column: 1 / -1;
    color: var(--muted);
  }
  .feature .actions {
    grid-column: 1 / -1;
    margin-top: 0;
  }
  .more {
    margin-top: 1.75rem;
    color: var(--muted);
  }

  .how dl {
    margin-top: 1.25rem;
    border-top: 2px solid var(--ink);
  }
  .how dl > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: 0.5rem clamp(1.5rem, 5vw, 4rem);
    padding: 1.4rem 0;
    border-bottom: 1.5px solid var(--rule);
  }
  .how dt {
    font-size: clamp(1.3rem, 2.4vw, 1.6rem);
    line-height: 1.4;
  }
  .how dd {
    max-width: var(--measure);
    color: var(--muted);
  }
  .how .a {
    color: var(--grape);
    font-weight: 700;
  }
  .how .b {
    color: var(--teal);
    font-weight: 700;
  }

  @media (max-width: 820px) {
    .hero-copy,
    .feature,
    .how dl > div {
      grid-template-columns: 1fr;
    }
    .hero-map :global(figcaption) {
      position: static;
      transform: none;
    }
  }
</style>
