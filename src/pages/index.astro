---
import Base from "../layouts/Base.astro";
import CourseMap from "../components/CourseMap.astro";
import Art from "../components/Art.astro";
import { lessons } from "../data/course";
import { aiCourse, aiLessons, aiBoardNodes, aiBoardEdges, aiBoardRegions, AI_BOARD_W, AI_BOARD_H } from "../data/ai-course";
import { url } from "../lib/url";

const aiHome = url("/courses/ai/");
const obsidianHome = url("/courses/obsidian/");
---

<Base current="home" description="把一門課攤開成一張白板：每一堂是一張卡片，前後呼應的地方畫成連線。">
  <main>
    <section class="hero">
      <div class="wrap">
        <h1>
          把一門課<Art kind="doodle" name="sparkle-trio" size={78} rotate={8} class="spark" /><br />攤開成<span class="scribble">一張白板</span>
        </h1>
        <p class="lede">
          每一堂是一張卡片，前後呼應的地方畫成連線。學到哪裡、下一堂是什麼，一眼就看得到。進度記在你的瀏覽器裡，不用登入，也不評分。
        </p>
        <p class="ask">
          <Art kind="doodle" name="arrow-swoop" size={64} rotate={62} class="arrow" />
          這裡有兩門課，上課的人不一樣。先找到你的那一門。
        </p>
      </div>
    </section>

    <section class="doors" id="courses" aria-label="課程">
      <div class="wrap">
        <article class="door ai">
          <Art name="laptop-open" size={104} rotate={7} class="pinned" />
          <h2><a href={aiHome}>{aiCourse.title}</a></h2>
          <p class="for">給護理系大學部的學生</p>
          <p class="what">
            {aiCourse.subtitle}。學會用 AI 讀懂一篇論文、整理出重點、寫出讀書報告的大綱，並且知道什麼時候不能信它。
          </p>
          <ul class="facts">
            <li>{aiLessons.length} 堂短課，每堂約 10 分鐘</li>
            <li>一堂 60 分鐘的實體課，不用先看完短課</li>
            <li>簡報是初稿，影片還在製作</li>
          </ul>
          <div class="thumb">
            <CourseMap
              nodes={aiBoardNodes}
              edges={aiBoardEdges}
              regions={aiBoardRegions}
              width={AI_BOARD_W}
              height={AI_BOARD_H}
              hrefFor={(n) => (n.kind === "lesson" ? url(`/courses/ai/lessons/${n.no}/`) : url("/courses/ai/#workshop"))}
              label={`${aiCourse.title}的課程地圖`}
            />
          </div>
          <a class="btn btn-primary" href={aiHome}>
            進入這門課
            <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"
              ><path d="M3 9h11M10 4.5 14.5 9 10 13.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg
            >
          </a>
        </article>

        <article class="door obsidian">
          <Art name="notebook" size={100} rotate={-7} class="pinned" />
          <h2><a href={obsidianHome}>Obsidian <span class="nb">研究筆記課</span></a></h2>
          <p class="for">給護理領域的研究生與老師</p>
          <p class="what">
            從安裝開始，學會讓筆記互相連結、加上欄位、排成表格與看板，最後把筆記組成報告裡的一段文字。
          </p>
          <ul class="facts">
            <li>{lessons.length} 堂短課，每堂 10 到 15 分鐘</li>
            <li>一場線上直播，一場 3 小時的實體工作坊</li>
            <li>研究生與老師看同一支影片，做不同的練習</li>
          </ul>
          <div class="thumb">
            <CourseMap />
          </div>
          <a class="btn btn-primary" href={obsidianHome}>
            進入這門課
            <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"
              ><path d="M3 9h11M10 4.5 14.5 9 10 13.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg
            >
          </a>
        </article>
      </div>
    </section>

    <section class="section how">
      <div class="wrap">
        <Art name="pencil-cup" size={104} rotate={-5} class="pinned" />
        <h2>在這裡怎麼學</h2>
        <dl>
          <div>
            <dt>先看全貌，再挑一張卡片</dt>
            <dd>
              課程攤在白板上，上課順序是實線，前後呼應的地方是虛線。你可以拖動卡片、放大縮小，排成自己看得順的樣子。
            </dd>
          </div>
          <div>
            <dt>進度是給你自己看的</dt>
            <dd>
              學完一堂，在卡片上打勾。紀錄只存在你這台裝置的瀏覽器，沒有人看得到，也不算成績。換一台裝置會從頭開始。
            </dd>
          </div>
          <div>
            <dt>兩門課各上各的</dt>
            <dd>每門課有自己的白板、自己的進度。進到一門課之後，選單只會出現那門課的頁面。</dd>
          </div>
        </dl>
      </div>
    </section>
  </main>
</Base>

<style>
  .hero {
    padding-block: clamp(2rem, 6vw, 4.5rem) clamp(1rem, 3vw, 2rem);
  }
  .hero h1 {
    font-size: clamp(2.6rem, 7.4vw, 6rem);
    line-height: 1.2;
  }
  .hero h1 :global(.spark) {
    margin-left: 0.15em;
    vertical-align: 0.25em;
  }
  .hero .lede {
    margin-top: 1.5rem;
    color: var(--ink);
  }
  .ask {
    display: flex;
    align-items: flex-end;
    gap: 0.75rem;
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    font-size: clamp(1.2rem, 2.4vw, 1.5rem);
    line-height: 1.5;
  }
  .ask :global(.arrow) {
    margin-bottom: -1.4rem;
  }

  /* 兩門課是兩張分開的紙：左邊橘色標籤給學生，右邊藍色標籤給研究生與老師 */
  .doors {
    padding-block: clamp(1.5rem, 4vw, 3rem);
  }
  .doors .wrap {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }
  .door {
    --tab: var(--marker);
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(2.9rem, 5vw, 3.6rem) clamp(1.25rem, 3vw, 2.25rem) clamp(1.5rem, 3vw, 2.25rem);
    background:
      linear-gradient(var(--tab), var(--tab)) 0 0 / 100% 14px no-repeat,
      linear-gradient(var(--rule-red), var(--rule-red)) 0 2.2rem / 100% 2px no-repeat,
      var(--card);
    border-radius: 2px;
    box-shadow: var(--shadow);
    transition:
      rotate 0.25s var(--ease-settle),
      box-shadow 0.25s ease-out;
  }
  .door.ai {
    rotate: -0.7deg;
  }
  .door.obsidian {
    --tab: var(--blue);
    rotate: 0.6deg;
    margin-top: clamp(0rem, 3vw, 2.5rem);
  }
  .door:hover {
    rotate: 0deg;
    box-shadow: var(--shadow-lift);
  }
  .door :global(.pinned) {
    right: clamp(0.5rem, 2vw, 1.5rem);
    top: -34px;
  }
  .door h2 {
    padding-right: 5.5rem;
    font-size: clamp(1.8rem, 3.2vw, 2.5rem);
  }
  .door h2 .nb {
    white-space: nowrap;
  }
  .door h2 a {
    color: var(--ink);
    text-decoration: none;
  }
  .door h2 a:hover {
    color: var(--blue);
  }
  .for {
    align-self: flex-start;
    margin-top: 0.6rem;
    font-size: 1.25rem;
    font-weight: 700;
    background: linear-gradient(transparent 58%, var(--hi) 58% 92%, transparent 92%);
    padding-inline: 0.15em;
  }
  .what {
    margin-top: 0.9rem;
    color: var(--muted);
  }
  .facts {
    margin-top: 1rem;
    border-top: 1.5px solid var(--rule);
  }
  .facts li {
    padding: 0.5rem 0;
    border-bottom: 1.5px solid var(--rule);
  }
  .thumb {
    margin: 1.5rem 0;
    padding: 1rem;
    background: var(--linen), var(--desk);
    border-radius: 2px;
    box-shadow: inset 0 1px 4px rgb(var(--shade) / 0.25);
  }
  .thumb :global(figcaption) {
    display: none;
  }
  .door .btn {
    align-self: flex-start;
    margin-top: auto;
  }

  .how dl {
    margin-top: 1.25rem;
    border-top: 2px solid var(--ink);
  }
  .how dl > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: 0.5rem clamp(1.5rem, 5vw, 4rem);
    padding: 1.4rem 0;
    border-bottom: 1.5px solid var(--rule);
  }
  .how dt {
    font-size: clamp(1.3rem, 2.4vw, 1.6rem);
    line-height: 1.4;
  }
  .how dd {
    max-width: var(--measure);
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .doors .wrap,
    .how dl > div {
      grid-template-columns: 1fr;
    }
    .door.obsidian {
      margin-top: 1rem;
    }
    .ask :global(.arrow) {
      display: none;
    }
  }
</style>
