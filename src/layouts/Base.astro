---
import "../styles/global.css";
import { site } from "../data/site";
import { url } from "../lib/url";

interface Props {
  title?: string;
  description?: string;
  /** 頁首放在深色區塊上 */
  darkHead?: boolean;
  /** 白板頁自己處理版面，不要頁首頁尾 */
  bare?: boolean;
  current?: "home" | "course" | "ai" | "board";
}
const { title, description = site.tagline, darkHead = false, bare = false, current } = Astro.props;
const courses = {
  course: {
    name: "Obsidian 研究筆記課",
    short: "Obsidian 課",
    home: url("/courses/obsidian/"),
    links: [
      ["白板", url("/courses/obsidian/#board")],
      ["目錄", url("/courses/obsidian/#lessons")],
      ["直播與工作坊", url("/courses/obsidian/#events")],
    ],
  },
  ai: {
    name: "AI 不只是聊天",
    short: "AI 入門",
    home: url("/courses/ai/"),
    links: [
      ["白板", url("/courses/ai/#board")],
      ["大綱", url("/courses/ai/#lessons")],
      ["實體課", url("/courses/ai/#workshop")],
    ],
  },
} as const;
const course = current === "course" || current === "ai" ? courses[current] : null;
const fullTitle = title ? `${title}｜${site.name}` : site.name;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href={url("/fonts/KevinSans-Regular.woff2")} as="font" type="font/woff2" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Iansui&display=swap" rel="stylesheet" />
    <script is:inline>
      // 在畫面出現前套用上次選的身分，避免顏色閃一下
      try {
        if (JSON.parse(localStorage.getItem("lb:role")) === "b") document.documentElement.dataset.role = "b";
      } catch {}
    </script>
  </head>
  <body data-course={current === "ai" ? "ai" : current === "course" ? "obsidian" : undefined}>
    {
      !bare && (
        <header class:list={["site-head", { "in-course": course }]}>
          <a class="brand" href={course ? course.home : url("/")}>
            <svg width="30" height="30" viewBox="0 0 30 30" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5.2 6.4c5.6-.9 12.8-.7 19.4.2.5 5.2.3 11.6-.4 17.2-6 .7-12.6.6-18.6-.3-.7-5.6-.9-11.4-.4-17.1Z" fill="var(--card)" />
              <path d="M5.4 11.2c6.2-.5 12.8-.4 19 .2" stroke="var(--rule-red)" />
              <path d="M9 16c3.6-.3 8-.2 11.6.1M9 20.2c2.6-.2 5.4-.2 8 0" stroke="var(--rule)" />
            </svg>
            <span class="long">{course ? course.name : site.name}</span>
            <span class="short">{course ? course.short : "學習白板"}</span>
          </a>
          {
            // 每門課的對象不同，所以進到課程裡之後，選單只列這門課自己的頁面
            course ? (
              <nav aria-label={course.name}>
                {course.links.map(([label, href]) => (
                  <a href={href}>{label}</a>
                ))}
                <a class="all" href={url("/")}>
                  所有課程
                </a>
              </nav>
            ) : (
              <nav aria-label="課程">
                <a href={url("/courses/ai/")}>
                  <span class="long">AI 不只是聊天</span>
                  <span class="short">AI 入門</span>
                </a>
                <a href={url("/courses/obsidian/")}>
                  <span class="long">Obsidian 研究筆記課</span>
                  <span class="short">Obsidian</span>
                </a>
              </nav>
            )
          }
        </header>
      )
    }
    <slot />
    {
      !bare && (
        <footer class="site-foot">
          <div class="wrap">
            <span>{site.name}</span>
            <span>學習進度只存在你這台裝置的瀏覽器裡。</span>
          </div>
        </footer>
      )
    }
  </body>
</html>
