---
import "../styles/global.css";
import { site } from "../data/site";
import { url } from "../lib/url";

interface Props {
  title?: string;
  description?: string;
  /** 頁首放在深色區塊上 */
  darkHead?: boolean;
  /** 白板頁自己處理版面，不要頁首頁尾 */
  bare?: boolean;
  current?: "home" | "course" | "board";
}
const { title, description = site.tagline, darkHead = false, bare = false, current } = Astro.props;
const fullTitle = title ? `${title}｜${site.name}` : site.name;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&family=Noto+Serif+TC:wght@900&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // 在畫面出現前套用上次選的身分，避免顏色閃一下
      try {
        if (JSON.parse(localStorage.getItem("lb:role")) === "b") document.documentElement.dataset.role = "b";
      } catch {}
    </script>
  </head>
  <body>
    {
      !bare && (
        <header class:list={["site-head", { "on-dark": darkHead }]}>
          <a class="brand" href={url("/")}>
            <svg width="26" height="26" viewBox="0 0 26 26" aria-hidden="true">
              <path d="M6 6 L20 9 L13 20 Z" fill="none" stroke="currentColor" stroke-width="1.6" />
              <circle cx="6" cy="6" r="3.2" fill="currentColor" />
              <circle cx="20" cy="9" r="3.2" fill="currentColor" />
              <circle cx="13" cy="20" r="4.4" fill="var(--violet-light)" />
            </svg>
            {site.name}
          </a>
          <nav aria-label="主要">
            <a href={url("/courses/obsidian/")} aria-current={current === "course" ? "page" : undefined}>
              <span class="long">Obsidian 研究筆記課</span>
              <span class="short">課程</span>
            </a>
            <a href={url("/courses/obsidian/board/")}>學習白板</a>
          </nav>
        </header>
      )
    }
    <slot />
    {
      !bare && (
        <footer class="site-foot">
          <div class="wrap">
            <span>{site.name}</span>
            <span>學習進度只存在你這台裝置的瀏覽器裡。</span>
          </div>
        </footer>
      )
    }
  </body>
</html>
